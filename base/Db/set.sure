Db.set(conn: Db.Conn, key: String, val: String): IO<Outcome<Db.Err, Unit>>
  open conn
  case Db.key_err(key) as ke {
    some: IO.end<Outcome<Db.Err, Unit>>(Outcome.err<Db.Err, Unit>(ke.value))
    none: IO {
      get raw = IO.ask<String>("db_set", conn.id | "\n" | key | "\n" | val, (t) IO.end<String>(t))
      return Db.decode_unit(raw)
    }
  }
