    Test.group("Sure.Sheet", [
      Test.unit("init received", Test.nat(Sure.Sheet.received(Sure.Sheet.init), 0)),
      Test.unit("init total", Test.nat(Sure.Sheet.total_of(Sure.Sheet.init), 0)),
      Test.unit("init scroll", Test.nat(Sure.Sheet.scroll_of(Sure.Sheet.init), 0)),
      Test.unit("init cols", Test.nat(List.length<Nat>(Sure.Sheet.widths_of(Sure.Sheet.init)), 8)),
      Test.unit("init names", Test.nat(List.length<String>(Sure.Sheet.names_of(Sure.Sheet.init)), 8)),
      Test.unit("init listen", Test.string(Sure.Ui.listen_of<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Sheet.init), "S\n/sheet/rows\nchunk")),
      Test.unit("px zero", Test.string(Sure.Sheet.px(0), "0px")),
      Test.unit("letter A", Test.string(Sure.Sheet.letter(0), "A")),
      Test.unit("letter H", Test.string(Sure.Sheet.letter(7), "H")),
      Test.unit("letter oob", Test.string(Sure.Sheet.letter(8), "?")),
      Test.unit("first zero", Test.nat(Sure.Sheet.first(0, 1), 0)),
      Test.unit("first hz", Test.nat(Sure.Sheet.first(9, 0), 0)),
      Test.unit("first two", Test.nat(Sure.Sheet.first(4, 2), 2)),
      Test.unit("need hz", Test.nat(Sure.Sheet.need(8, 0, 1), 0)),
      Test.unit("start empty", Test.nat(Sure.Sheet.start(9, 1, 0, 0), 0)),
      Test.unit("count empty", Test.nat(Sure.Sheet.count(0, 8, 1, 0, 0), 0)),
      Test.unit("chunk zero", Test.string(Sure.Sheet.chunk(0, 0), "")),
      Test.unit("read row empty", Test.bool(Maybe.is_none<Sure.Sheet.Row>(Sure.Sheet.read_row("")), true)),
      Test.unit("read row junk", Test.bool(Maybe.is_none<Sure.Sheet.Row>(Sure.Sheet.read_row("nope")), true)),
      Test.unit("read row pad",
        case Sure.Sheet.read_row("0\tA") as r {
          none: Test.Result.fail("none")
          some: Test.nat(List.length<String>(Sure.Sheet.cells_of(r.value)), 8)
        }),
      Test.unit("read chunk empty", Test.nat(List.length<Sure.Sheet.Row>(Sure.Sheet.read_chunk("")), 0)),
      Test.unit("read chunk skip", Test.nat(List.length<Sure.Sheet.Row>(Sure.Sheet.read_chunk("\nnope\n\n0\tA")), 1)),
      Test.unit("col empty", Test.bool(Maybe.is_none<Nat>(Sure.Sheet.col_of("")), true)),
      Test.unit("col junk", Test.bool(Maybe.is_none<Nat>(Sure.Sheet.col_of("nope")), true)),
      Test.unit("col down empty", Test.bool(Maybe.is_none<Nat>(Sure.Sheet.col_of("down-")), true)),
      Test.unit("col down 0",
        case Sure.Sheet.col_of("down-0") as c {
          none: Test.Result.fail("none")
          some: Test.nat(c.value, 0)
        }),
      Test.unit("is page empty", Test.bool(Sure.Sheet.is_page(""), true)),
      Test.unit("is page slash", Test.bool(Sure.Sheet.is_page("/"), true)),
      Test.unit("is page junk", Test.bool(Sure.Sheet.is_page("/nope"), false)),
      Test.unit("is rows empty", Test.bool(Sure.Sheet.is_rows(""), false)),
      Test.unit("is rows hit", Test.bool(Sure.Sheet.is_rows("/sheet/rows"), true)),
      Test.unit("is save empty", Test.bool(Sure.Sheet.is_save(""), false)),
      Test.unit("is save hit", Test.bool(Sure.Sheet.is_save("/sheet/save?w=1"), true)),
      Test.unit("is state empty", Test.bool(Sure.Sheet.is_state(""), false)),
      Test.unit("is state hit", Test.bool(Sure.Sheet.is_state("/sheet/state"), true)),
      Test.unit("ok name empty", Test.bool(Sure.Sheet.ok_name(""), false)),
      Test.unit("ok name comma", Test.bool(Sure.Sheet.ok_name("a,b"), false)),
      Test.unit("ok name amp", Test.bool(Sure.Sheet.ok_name("a&b"), false)),
      Test.unit("ok name A", Test.bool(Sure.Sheet.ok_name("A"), true)),
      Test.unit("qget empty", Test.string(Sure.Sheet.qget("", "w"), "")),
      Test.unit("qget miss", Test.string(Sure.Sheet.qget("w=1", "n"), "")),
      Test.unit("qget hit", Test.string(Sure.Sheet.qget("w=1,2&n=A", "w"), "1,2")),
      Test.unit("qget key empty", Test.string(Sure.Sheet.qget("w=1", ""), "")),
      Test.unit("read nats empty", Test.bool(Maybe.is_none<List<Nat>>(Sure.Sheet.read_nats("")), true)),
      Test.unit("read nats junk", Test.bool(Maybe.is_none<List<Nat>>(Sure.Sheet.read_nats("1,x")), true)),
      Test.unit("apply empty", Test.nat(List.length<Nat>(Sure.Sheet.widths_of(Sure.Sheet.apply_state(Sure.Sheet.init, ""))), 8)),
      Test.unit("apply junk", Test.string(List.head_with_default<String>("", Sure.Sheet.names_of(Sure.Sheet.apply_state(Sure.Sheet.init, "nope"))), "A")),
      Test.unit("apply w short", Test.nat(List.head_with_default<Nat>(0, Sure.Sheet.widths_of(Sure.Sheet.apply_state(Sure.Sheet.init, "w=9"))), Sure.Sheet.def_w)),
      Test.unit("apply n", Test.string(List.head_with_default<String>("", Sure.Sheet.names_of(Sure.Sheet.apply_state(Sure.Sheet.init, "n=Cost"))), "Cost")),
      Test.unit("apply n empty tok", Test.string(List.head_with_default<String>("", Sure.Sheet.names_of(Sure.Sheet.apply_state(Sure.Sheet.init, "n=,"))), "A")),
      Test.unit("apply n junk tok", Test.string(List.head_with_default<String>("", Sure.Sheet.names_of(Sure.Sheet.apply_state(Sure.Sheet.init, "n=a=b"))), "A")),
      Test.unit("set name empty", Test.string(List.head_with_default<String>("", Sure.Sheet.set_name(0, "", Sure.Sheet.letters)), "A")),
      Test.unit("set name ok", Test.string(List.head_with_default<String>("", Sure.Sheet.set_name(0, "Cost", Sure.Sheet.letters)), "Cost")),
      Test.unit("set name oob", Test.nat(List.length<String>(Sure.Sheet.set_name(9, "X", Sure.Sheet.letters)), 8)),
      Test.unit("encode n pad", Test.bool(String.includes(Sure.Sheet.encode_n(["Cost"]), "Cost"), true)),
      Test.unit("save url", Test.bool(String.starts_with(Sure.Sheet.save_url([1], ["A"]), "/sheet/save?w="), true)),
      Test.unit("clamp min", Test.nat(Sure.Sheet.clamp_w(0), Sure.Sheet.min_w)),
      Test.unit("resize grow", Test.nat(Sure.Sheet.resize_w(Sure.Sheet.min_w, 1, 3), Nat.add(Sure.Sheet.min_w, 2))),
      Test.unit("resize shrink min", Test.nat(Sure.Sheet.resize_w(Sure.Sheet.min_w, 5, 0), Sure.Sheet.min_w)),
      Test.unit("ingest empty", Test.nat(Sure.Sheet.received(Sure.Sheet.ingest(Sure.Sheet.init, "")), 0)),
      Test.unit("ingest junk", Test.nat(Sure.Sheet.received(Sure.Sheet.ingest(Sure.Sheet.init, "nope")), 0)),
      Test.unit("ingest rows", Test.nat(Sure.Sheet.received(Sure.Sheet.ingest(Sure.Sheet.init, "rows\n0\tA")), 1)),
      Test.unit("ingest rows semi", Test.nat(Sure.Sheet.received(Sure.Sheet.ingest(Sure.Sheet.init, "rows;0\tA;1\tB")), 2)),
      Test.unit("ingest meta space", Test.nat(Sure.Sheet.total_of(Sure.Sheet.ingest(Sure.Sheet.init, "meta 3")), 3)),
      Test.unit("ingest plain", Test.nat(Sure.Sheet.received(Sure.Sheet.ingest(Sure.Sheet.init, "0\tA")), 1)),
      Test.unit("ingest meta", Test.nat(Sure.Sheet.total_of(Sure.Sheet.ingest(Sure.Sheet.init, "meta\n3")), 3)),
      Test.unit("ingest meta junk", Test.nat(Sure.Sheet.total_of(Sure.Sheet.ingest(Sure.Sheet.init, "meta\nno")), 0)),
      Test.unit("ingest done", Test.bool(Sure.Sheet.done_of(Sure.Sheet.ingest(Sure.Sheet.init, "done")), true)),
      Test.unit("ingest done n", Test.nat(Sure.Sheet.total_of(Sure.Sheet.ingest(Sure.Sheet.init, "done\n3")), 3)),
      Test.unit("done listen none", Test.string(Sure.Ui.listen_of<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Sheet.ingest(Sure.Sheet.init, "done")), "")),
      Test.unit("boot load", Test.string(Sure.Ui.boot_of<Sure.Sheet.Model>(Sure.Sheet.client), "H\n/sheet/state\nload")),
      Test.unit("load empty", Test.string(List.head_with_default<String>("", Sure.Sheet.names_of(Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Ui.wire("http", "load", "", ""), Sure.Sheet.init))), "A")),
      Test.unit("load junk", Test.string(List.head_with_default<String>("", Sure.Sheet.names_of(Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Ui.wire("http", "load", "", "BODY"), Sure.Sheet.init))), "A")),
      Test.unit("load name", Test.string(List.head_with_default<String>("", Sure.Sheet.names_of(Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Ui.wire("http", "load", "", "n=Cost"), Sure.Sheet.init))), "Cost")),
      Test.unit("name change", Test.string(List.head_with_default<String>("", Sure.Sheet.names_of(Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Ui.wire("change", "name-0", "", "Cost"), Sure.Sheet.init))), "Cost")),
      Test.unit("name empty", Test.string(List.head_with_default<String>("", Sure.Sheet.names_of(Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Ui.wire("change", "name-0", "", ""), Sure.Sheet.init))), "A")),
      Test.unit("name junk", Test.string(List.head_with_default<String>("", Sure.Sheet.names_of(Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Ui.wire("change", "name-0", "", "a,b"), Sure.Sheet.init))), "A")),
      Test.unit("name oob", Test.string(List.head_with_default<String>("", Sure.Sheet.names_of(Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Ui.wire("change", "name-9", "", "X"), Sure.Sheet.init))), "A")),
      Test.unit("name save fx", Test.bool(String.starts_with(Sure.Ui.step_fx<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Ui.wire("change", "name-0", "", "Cost"), Sure.Sheet.init), "H\n/sheet/save?"), true)),
      Test.unit("saved idle", Test.nat(Sure.Sheet.received(Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Ui.wire("http", "saved", "", "ok"), Sure.Sheet.init)), 0)),
      Test.unit("miss", Test.nat(Sure.Sheet.received(Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Ui.wire("click", "nope", "", ""), Sure.Sheet.init)), 0)),
      Test.unit("empty wire", Test.nat(Sure.Sheet.scroll_of(Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, "", Sure.Sheet.init)), 0)),
      Test.unit("scroll", Test.nat(Sure.Sheet.scroll_of(Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Ui.wire("scroll", "scroll", "", "4"), Sure.Sheet.init)), 4)),
      Test.unit("scroll junk", Test.nat(Sure.Sheet.scroll_of(Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Ui.wire("scroll", "scroll", "", "no"), Sure.Sheet.init)), 0)),
      Test.unit("move idle", Test.nat(Sure.Sheet.scroll_of(Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Sheet.ptr("mousemove", "move", 9), Sure.Sheet.init)), 0)),
      Test.unit("down oob",
        case Sure.Sheet.drag_of(Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Sheet.ptr("mousedown", "down-9", 1), Sure.Sheet.init)) {
          none: Test.assert(true, "ok")
          col: Test.Result.fail("drag")
        }),
      Test.unit("resize col",
        let a = Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Sheet.ptr("mousedown", "down-0", 2), Sure.Sheet.init)
        let b = Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Sheet.ptr("mousemove", "move", 4), a)
        Test.nat(List.head_with_default<Nat>(0, Sure.Sheet.widths_of(b)), Nat.add(Sure.Sheet.def_w, 2))),
      Test.unit("up clears",
        let a = Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Sheet.ptr("mousedown", "down-0", 2), Sure.Sheet.init)
        case Sure.Sheet.drag_of(Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Ui.wire("mouseup", "up", "", ""), a)) {
          none: Test.assert(true, "ok")
          col: Test.Result.fail("drag")
        }),
      Test.unit("up save fx",
        let a = Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Sheet.ptr("mousedown", "down-0", 2), Sure.Sheet.init)
        Test.bool(String.starts_with(Sure.Ui.step_fx<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Ui.wire("mouseup", "up", "", ""), a), "H\n/sheet/save?"), true)),
      Test.unit("draw header", Test.bool(String.includes(Sure.Ui.draw_of<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Sheet.init), "data-sure-scroll"), true)),
      Test.unit("draw excel", Test.bool(String.includes(Sure.Ui.draw_of<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Sheet.init), "Excel"), true)),
      Test.unit("draw empty no row", Test.bool(String.includes(Sure.Ui.draw_of<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Sheet.init), "data-sure-row"), false)),
      Test.unit("draw letter A", Test.bool(String.includes(Sure.Ui.draw_of<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Sheet.init), "value=\"A\""), true)),
      Test.unit("draw daisy navbar", Test.bool(String.includes(Sure.Ui.draw_of<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Sheet.init), "navbar"), true)),
      Test.unit("draw daisy input", Test.bool(String.includes(Sure.Ui.draw_of<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Sheet.init), "input-ghost"), true)),
      Test.unit("draw no style attr", Test.bool(String.includes(Sure.Ui.draw_of<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Sheet.init), " style=\""), false)),
      Test.unit("virtual window",
        let more = Sure.Sheet.read_chunk(Sure.Sheet.chunk(0, Nat.read("40")))
        let m = Sure.Sheet.append(Sure.Sheet.init, more)
        let html = Sure.Ui.draw_of<Sure.Sheet.Model>(Sure.Sheet.client, m)
        Test.bool(Bool.and(String.includes(html, "data-sure-row=\"0\""), Bool.not(String.includes(html, "data-sure-row=\"39\""))), true)),
      Test.unit("virtual scroll",
        let more = Sure.Sheet.read_chunk(Sure.Sheet.chunk(0, Nat.read("40")))
        let m0 = Sure.Sheet.append(Sure.Sheet.init, more)
        let m = Sure.Ui.step_model<Sure.Sheet.Model>(Sure.Sheet.client, Sure.Ui.wire("scroll", "scroll", "", Nat.show(Nat.mul(Sure.Sheet.row_h, Nat.read("20")))), m0)
        let html = Sure.Ui.draw_of<Sure.Sheet.Model>(Sure.Sheet.client, m)
        Test.bool(String.includes(html, "data-sure-row=\"20\""), true)),
      Test.unit("line tab", Test.bool(String.includes(Sure.Sheet.line(0), "\t"), true)),
    ]),
    Test.group("Sure.Tweeter", [
      Test.unit("cmd post", Test.string(Sure.Ui.Cmd.show(Sure.Ui.Cmd.post("/u", "b", "ok")), "O\n/u\nok\nb")),
      Test.unit("cmd post empty url", Test.string(Sure.Ui.Cmd.show(Sure.Ui.Cmd.post("", "b", "ok")), "")),
      Test.unit("cmd post empty body", Test.string(Sure.Ui.Cmd.show(Sure.Ui.Cmd.post("/u", "", "ok")), "O\n/u\nok\n")),
      Test.unit("cmd read post empty url", Test.bool(Sure.Ui.Cmd.is_none(Sure.Ui.Cmd.read("O\n\nok\nb")), true)),
      Test.unit("cmd roundtrip post", Test.string(Sure.Ui.Cmd.show(Sure.Ui.Cmd.read("O\n/u\nok\nb")), "O\n/u\nok\nb")),
      Test.unit("ok user empty", Test.bool(Sure.Tweeter.ok_user(""), false)),
      Test.unit("ok user space", Test.bool(Sure.Tweeter.ok_user("a b"), false)),
      Test.unit("ok user slash", Test.bool(Sure.Tweeter.ok_user("a/b"), false)),
      Test.unit("ok user ada", Test.bool(Sure.Tweeter.ok_user("ada"), true)),
      Test.unit("ok pass empty", Test.bool(Sure.Tweeter.ok_pass(""), false)),
      Test.unit("ok pass nl", Test.bool(Sure.Tweeter.ok_pass("a\nb"), false)),
      Test.unit("ok pass x", Test.bool(Sure.Tweeter.ok_pass("x"), true)),
      Test.unit("ok text empty", Test.bool(Sure.Tweeter.ok_text(""), false)),
      Test.unit("ok text tilde", Test.bool(Sure.Tweeter.ok_text("a~b"), false)),
      Test.unit("ok text hi", Test.bool(Sure.Tweeter.ok_text("hi"), true)),
