      Test.unit("auth sid", Test.string(Sure.Tweeter.auth_sid("ok e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855 ada"), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")),
      Test.unit("read me empty", Test.bool(Maybe.is_none<Pair<String, String>>(Sure.Tweeter.read_me("")), true)),
      Test.unit("read me junk", Test.bool(Maybe.is_none<Pair<String, String>>(Sure.Tweeter.read_me("ok nope ada")), true)),
