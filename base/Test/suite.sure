    Test.group("Sure.Doc", [
      Test.unit("is comment", Test.bool(Sure.Doc.is_comment("// hi"), true)),
      Test.unit("not comment", Test.bool(Sure.Doc.is_comment("Foo: Nat"), false)),
      Test.unit("empty comment", Test.bool(Sure.Doc.is_comment(""), false)),
      Test.unit("slash only", Test.bool(Sure.Doc.is_comment("/"), false)),
      Test.unit("body hi", Test.string(Sure.Doc.body("// hi"), "hi")),
      Test.unit("body tight", Test.string(Sure.Doc.body("//hi"), "hi")),
      Test.unit("body not", Test.string(Sure.Doc.body("Foo: Nat"), "")),
      Test.unit("leading hi", Test.string(Sure.Doc.leading("// hi\nFoo: Nat"), "hi")),
      Test.unit("leading none", Test.string(Sure.Doc.leading("Foo: Nat"), "")),
      Test.unit("leading empty", Test.string(Sure.Doc.leading(""), "")),
      Test.unit("leading after", Test.string(Sure.Doc.leading("Foo: Nat\n// later"), "")),
      Test.unit("leading two", Test.string(Sure.Doc.leading("// a\n// b\nFoo"), "a\nb")),
    ]),
    Test.group("Sure.Json", [
      Test.unit("escape empty", Test.string(Sure.Json.escape(""), "")),
      Test.unit("escape quote", Test.string(Sure.Json.escape("\""), "\\\"")),
      Test.unit("escape slash", Test.string(Sure.Json.escape("\\"), "\\\\")),
      Test.unit("string wrap", Test.string(Sure.Json.string("a"), "\"a\"")),
    ]),
    Test.group("Test.assert", [
      Test.unit("true is pass", Test.assert(true, "ok")),
      Test.unit("false is fail",
        case Test.assert(false, "boom") {
          pass: Test.Result.fail("should have failed")
          fail: Test.Result.pass
        }),
    ]),
    Test.io("cli load empty", IO {
      get c = Sure.Cli.load
      return Test.nat(Sure.Cli.count(c), 0)
    }),
    Test.io("log put off", IO {
      get u = Sure.Log.put(Sure.Debug.Level.off, Sure.Debug.Level.info, "t", "no")
      return Test.Result.pass
    }),
    Test.io("env get empty name", IO {
      get r = Sure.Env.get("")
      return case r {
        ok: Test.Result.fail("empty name")
        err: Test.string(Sure.Env.Err.show(r.error), "empty_name")
