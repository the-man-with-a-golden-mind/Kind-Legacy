Test.suite: Test
  Test.group("Sure security suite", [
    Test.group("Nat.read_base", [
      Test.unit("empty", Test.nat(Nat.read_base(10, ""), 0)),
      Test.unit("dec 0", Test.nat(Nat.read_base(10, "0"), 0)),
      Test.unit("dec 42", Test.nat(Nat.read_base(10, "42"), 42)),
      Test.unit("hex ff", Test.nat(Nat.read_base(16, "ff"), 255)),
      Test.unit("hex FF", Test.nat(Nat.read_base(16, "FF"), 255)),
      Test.unit("bin 1010", Test.nat(Nat.read_base(2, "1010"), 10)),
      Test.unit("stops at x", Test.nat(Nat.read_base(10, "12x3"), 12)),
      Test.unit("stops at invalid first", Test.nat(Nat.read_base(10, "!9"), 0)),
      Test.unit("digit above base", Test.nat(Nat.read_base(2, "2"), 0)),
    ]),
    Test.group("Word.from_bits", [
      Test.unit("zero", Test.bool(Word.eql<0>(Word.from_bits(0, Bits.e), Word.e), true)),
    ]),
    Test.group("String.slice", [
      Test.unit("middle", Test.string(String.slice(1, 4, "abcdef"), "bcd")),
      Test.unit("all", Test.string(String.slice(0, 3, "abc"), "abc")),
      Test.unit("empty range", Test.string(String.slice(2, 2, "abc"), "")),
      Test.unit("nil", Test.string(String.slice(0, 4, ""), "")),
    ]),
    Test.group("String.ops", [
      Test.unit("replace empty needle", Test.string(String.replace("a", "", "x"), "a")),
      Test.unit("replace miss", Test.string(String.replace("a", "b", "c"), "a")),
      Test.unit("replace hit", Test.string(String.replace("a", "a", "b"), "b")),
      Test.unit("replace_all empty", Test.string(String.replace_all("aa", "", "b"), "aa")),
      Test.unit("replace_all aa", Test.string(String.replace_all("aa", "a", "b"), "bb")),
      Test.unit("index empty",
        case String.index_of("ab", "") as i {
          none: Test.Result.fail("none")
          some: Test.nat(i.value, 0)
        }),
      Test.unit("index miss", Test.bool(Maybe.is_none<Nat>(String.index_of("ab", "c")), true)),
      Test.unit("count empty needle", Test.nat(String.count("aaa", ""), 0)),
      Test.unit("count a", Test.nat(String.count("aaa", "a"), 3)),
      Test.unit("lines empty", Test.nat(List.length<String>(String.lines("")), 1)),
      Test.unit("words empty", Test.nat(List.length<String>(String.words("")), 0)),
      Test.unit("trim left empty", Test.string(String.trim_left(""), "")),
      Test.unit("trim left space", Test.string(String.trim_left(" a"), "a")),
      Test.unit("space char", Test.bool(Char.is_space(' '), true)),
      Test.unit("a not space", Test.bool(Char.is_space('a'), false)),
      Test.unit("has_none nil", Test.bool(String.has_none("x", []), true)),
      Test.unit("has_none space", Test.bool(String.has_none("a b", [" "]), false)),
      Test.unit("ok empty", Test.bool(String.ok("", [" "]), false)),
      Test.unit("ok ada", Test.bool(String.ok("ada", [" ", "\n", "&", "="]), true)),
    ]),
    Test.group("Regex", [
      Test.unit("empty", Test.bool(Regex.ok("", ""), true)),
      Test.unit("junk", Test.bool(Maybe.is_none<Regex>(Regex.read("[")), true)),
      Test.unit("lit", Test.bool(Regex.ok("a", "a"), true)),
      Test.unit("miss", Test.bool(Regex.ok("a", "b"), false)),
      Test.unit("star empty", Test.bool(Regex.ok("a*", ""), true)),
      Test.unit("star aa", Test.bool(Regex.ok("a*", "aa"), true)),
      Test.unit("empty s", Test.bool(Regex.ok("a", ""), false)),
      Test.unit("alt", Test.bool(Regex.ok("a|b", "b"), true)),
      Test.unit("dot", Test.bool(Regex.ok(".", "q"), true)),
    ]),
    Test.group("Parse", [
      Test.unit("nat empty", Test.bool(Maybe.is_none<Nat>(Parse.nat("")), true)),
      Test.unit("nat junk", Test.bool(Maybe.is_none<Nat>(Parse.nat("12x")), true)),
      Test.unit("nat zero",
        case Parse.nat("0") as n {
          none: Test.Result.fail("none")
          some: Test.nat(n.value, 0)
        }),
      Test.unit("bool empty", Test.bool(Maybe.is_none<Bool>(Parse.bool("")), true)),
      Test.unit("bool junk", Test.bool(Maybe.is_none<Bool>(Parse.bool("yes")), true)),
      Test.unit("hex empty", Test.bool(Maybe.is_none<Nat>(Parse.hex("")), true)),
      Test.unit("hex junk", Test.bool(Maybe.is_none<Nat>(Parse.hex("gg")), true)),
      Test.unit("f64 empty", Test.bool(Maybe.is_none<F64>(Parse.f64("")), true)),
      Test.unit("f64 junk", Test.bool(Maybe.is_none<F64>(Parse.f64("abc")), true)),
    ]),
    Test.group("Bytes", [
      Test.unit("length empty", Test.nat(Bytes.length([]), 0)),
      Test.unit("is empty", Test.bool(Bytes.is_empty([]), true)),
      Test.unit("eql empty", Test.bool(Bytes.eql([], []), true)),
      Test.unit("get empty", Test.bool(Maybe.is_none<U8>(Bytes.get(0, [])), true)),
      Test.unit("xor empty", Test.bool(Bytes.eql(Bytes.xor([], []), []), true)),
      Test.unit("slice empty", Test.bool(Bytes.eql(Bytes.slice(0, 1, []), []), true)),
    ]),
    Test.group("F64", [
      Test.unit("dec empty", Test.bool(F64.is_dec(""), false)),
      Test.unit("dec junk", Test.bool(F64.is_dec("abc"), false)),
      Test.unit("dec zero", Test.bool(F64.is_dec("0"), true)),
      Test.unit("dec tail", Test.bool(F64.is_dec("12x"), false)),
      Test.unit("read empty", Test.bool(Maybe.is_none<F64>(F64.read_dec("")), true)),
      Test.unit("is zero", Test.bool(F64.is_zero(F64.0), true)),
      Test.unit("nan of zero", Test.bool(F64.is_nan(F64.0), false)),
      Test.unit("inf of zero", Test.bool(F64.is_inf(F64.0), false)),
      Test.unit("finite zero", Test.bool(F64.is_finite(F64.0), true)),
      Test.unit("floor zero", Test.bool(F64.eql(F64.floor(F64.0), F64.0), true)),
      Test.unit("floor pos", Test.bool(F64.eql(F64.floor(1.9), 1.0), true)),
      Test.unit("floor neg", Test.bool(F64.eql(F64.floor(-1.1), -2.0), true)),
      Test.unit("floor near", Test.bool(F64.eql(F64.floor(0.9999999999999), 0.0), true)),
      Test.unit("parse bin empty", Test.bool(F64.eql(F64.parse_binary(""), F64.0), true)),
      Test.unit("parse bin junk", Test.bool(F64.eql(F64.parse_binary("xxxx"), F64.0), true)),
      Test.unit("atan2 east", Test.bool(F64.eql(F64.atan2(0.0, 1.0), 0.0), true)),
    ]),
    Test.group("F32.parse_binary", [
      Test.unit("empty", Test.bool(F32.eql(F32.parse_binary(""), F32.0), true)),
      Test.unit("junk", Test.bool(F32.eql(F32.parse_binary("xxxx"), F32.0), true)),
      Test.unit("two", Test.bool(F32.eql(F32.parse_binary("00000000000000000000000000000010"), F32.2), true)),
      Test.unit("one", Test.bool(F32.eql(F32.parse_binary("00000000000000000000000111111100"), F32.1), true)),
      Test.unit("floor zero", Test.bool(F32.eql(F32.floor(F32.0), F32.0), true)),
    ]),
    Test.group("Parser.f64", [
      Test.unit("empty", Test.bool(Maybe.is_none<F64>(Parser.run<F64>(Parser.f64, "")), true)),
      Test.unit("junk", Test.bool(Maybe.is_none<F64>(Parser.run<F64>(Parser.f64, "abc")), true)),
      Test.unit("int",
        case Parser.run<F64>(Parser.f64, "12") as n {
          none: Test.Result.fail("none")
          some: Test.bool(F64.eql(n.value, 12.0), true)
        }),
      Test.unit("frac",
        case Parser.run<F64>(Parser.f64, "1.5") as n {
          none: Test.Result.fail("none")
          some: Test.bool(F64.eql(n.value, 1.5), true)
        }),
      Test.unit("exp",
        case Parser.run<F64>(Parser.f64, "1e2") as n {
          none: Test.Result.fail("none")
          some: Test.bool(F64.eql(n.value, 100.0), true)
        }),
      Test.unit("neg",
        case Parser.run<F64>(Parser.f64, "-2.5") as n {
          none: Test.Result.fail("none")
          some: Test.bool(F64.eql(n.value, -2.5), true)
        }),
    ]),
    Test.group("Bits.to_string", [
      Test.unit("empty", Test.string(Bits.to_string(Bits.e), "")),
      Test.unit("o", Test.string(Bits.to_string(Bits.o(Bits.e)), "0")),
      Test.unit("i", Test.string(Bits.to_string(Bits.i(Bits.e)), "1")),
    ]),
    Test.group("Word.to_f64", [
      Test.unit("e", Test.bool(F64.eql(Word.to_f64<0>(Word.e), F64.0), true)),
      Test.unit("one", Test.bool(F64.eql(Word.to_f64<1>(Word.i<0>(Word.e)), 1.0), true)),
      Test.unit("s one", Test.bool(F64.eql(Word.s_to_f64<1>(Word.i<0>(Word.e)), -1.0), true)),
      Test.unit("s zero", Test.bool(F64.eql(Word.s_to_f64<0>(Word.e), F64.0), true)),
    ]),
    Test.group("utf8", [
      Test.unit("empty", Test.string(String.hex.decode.utf8(""), "")),
      Test.unit("junk", Test.string(String.hex.decode.utf8("zz"), "")),
      Test.unit("A", Test.string(String.hex.decode.utf8("41"), "A")),
      Test.unit("AB", Test.string(String.hex.decode.utf8("4142"), "AB")),
      Test.unit("incomplete", Test.string(String.hex.decode.utf8("c3"), "")),
      Test.unit("two byte", Test.string(String.hex.decode.utf8("c3a9"), "é")),
      Test.unit("surr hex", Test.string(U16.to_hex.show(0xD800), "efbfbd")),
    ]),
    Test.group("Nat.parse_decimal", [
      Test.unit("empty", Test.nat(Nat.parse_decimal(""), 0)),
      Test.unit("junk", Test.nat(Nat.parse_decimal("x"), 0)),
      Test.unit("stop", Test.nat(Nat.parse_decimal("12x"), 12)),
      Test.unit("42", Test.nat(Nat.parse_decimal("42"), 42)),
    ]),
    Test.group("Sure", [
      Test.unit("name", Test.string(Sure.name, "Sure")),
      Test.unit("version", Test.string(Sure.version, "0.1.0")),
      Test.unit("how next", Test.string(Sure.How.next, "sure prove && sure build && sure run")),
      Test.unit("how empty topic", Test.bool(Sure.How.is_topic(""), false)),
      Test.unit("how json topic", Test.bool(Sure.How.is_topic("json"), true)),
      Test.unit("how junk topic", Test.bool(Sure.How.is_topic("xyz"), false)),
      Test.unit("how ffi topic", Test.bool(Sure.How.is_topic("ffi"), true)),
      Test.unit("how gen topic", Test.bool(Sure.How.is_topic("gen"), true)),
      Test.unit("how pkg topic", Test.bool(Sure.How.is_topic("pkg"), true)),
      Test.unit("how bun topic", Test.bool(Sure.How.is_topic("bun"), true)),
      Test.unit("how worker topic", Test.bool(Sure.How.is_topic("worker"), true)),
      Test.unit("how db topic", Test.bool(Sure.How.is_topic("db"), true)),
      Test.unit("how debug topic", Test.bool(Sure.How.is_topic("debug"), true)),
      Test.unit("how lsp topic", Test.bool(Sure.How.is_topic("lsp"), true)),
      Test.unit("how pipe topic", Test.bool(Sure.How.is_topic("pipe"), true)),
      Test.unit("how time topic", Test.bool(Sure.How.is_topic("time"), true)),
      Test.unit("how cli topic", Test.bool(Sure.How.is_topic("cli"), true)),
      Test.unit("how log topic", Test.bool(Sure.How.is_topic("log"), true)),
      Test.unit("how repl topic", Test.bool(Sure.How.is_topic("repl"), true)),
      Test.unit("how test topic", Test.bool(Sure.How.is_topic("test"), true)),
      Test.unit("how env topic", Test.bool(Sure.How.is_topic("env"), true)),
      Test.unit("how cfg topic", Test.bool(Sure.How.is_topic("cfg"), true)),
      Test.unit("how ssr topic", Test.bool(Sure.How.is_topic("ssr"), true)),
      Test.unit("how ui topic", Test.bool(Sure.How.is_topic("ui"), true)),
      Test.unit("how web topic", Test.bool(Sure.How.is_topic("web"), true)),
      Test.unit("cli tokens empty", Test.nat(List.length<String>(Sure.Cli.tokens("")), 0)),
      Test.unit("cli parse empty", Test.nat(Sure.Cli.count(Sure.Cli.parse([])), 0)),
      Test.unit("cli flag empty", Test.bool(Sure.Cli.flag(Sure.Cli.empty, ""), false)),
      Test.unit("cli flag miss", Test.bool(Sure.Cli.flag(Sure.Cli.empty, "x"), false)),
      Test.unit("cli nth empty", Test.bool(Maybe.is_none<String>(Sure.Cli.nth(Sure.Cli.empty, 0)), true)),
      Test.unit("cli get empty", Test.bool(Maybe.is_none<String>(Sure.Cli.get(Sure.Cli.empty, "")), true)),
      Test.unit("cli flag on", Test.bool(Sure.Cli.flag(Sure.Cli.parse(["--x"]), "x"), true)),
      Test.unit("cli get eq",
        case Sure.Cli.get(Sure.Cli.parse(["--x=y"]), "x") as v {
          none: Test.Result.fail("none")
          some: Test.string(v.value, "y")
        }),
      Test.unit("cli rest", Test.nat(Sure.Cli.count(Sure.Cli.parse(["a"])), 1)),
      Test.unit("cli end", Test.bool(Sure.Cli.flag(Sure.Cli.parse(["--", "--x"]), "x"), false)),
      Test.unit("cli junk eq", Test.bool(Sure.Cli.flag(Sure.Cli.parse(["--=z"]), "z"), false)),
      Test.unit("log want off", Test.bool(Sure.Log.want(Sure.Debug.Level.off, Sure.Debug.Level.info), false)),
      Test.unit("log format off", Test.bool(Maybe.is_none<String>(Sure.Log.format(Sure.Debug.Level.off, Sure.Debug.Level.info, "t", "m")), true)),
      Test.unit("log format info",
        case Sure.Log.format(Sure.Debug.Level.info, Sure.Debug.Level.info, "t", "m") as l {
          none: Test.Result.fail("none")
          some: Test.string(l.value, "info t m")
        }),
      Test.unit("repl line empty", Test.bool(Maybe.is_none<Pair<Sure.Repl.Cmd, String>>(Sure.Repl.line("")), true)),
      Test.unit("repl line colon", Test.bool(Maybe.is_none<Pair<Sure.Repl.Cmd, String>>(Sure.Repl.line(":")), true)),
      Test.unit("repl line junk", Test.bool(Maybe.is_none<Pair<Sure.Repl.Cmd, String>>(Sure.Repl.line(":xyz")), true)),
      Test.unit("repl read empty", Test.bool(Maybe.is_none<Sure.Repl.Cmd>(Sure.Repl.Cmd.read("")), true)),
      Test.unit("repl read help",
        case Sure.Repl.Cmd.read("help") as c {
          none: Test.Result.fail("none")
          some: Test.string(Sure.Repl.Cmd.show(c.value), "help")
        }),
      Test.unit("repl show quit", Test.string(Sure.Repl.Cmd.show(Sure.Repl.Cmd.quit), "quit")),
      Test.unit("env ok empty", Test.bool(Sure.Env.ok_name(""), false)),
      Test.unit("env ok path", Test.bool(Sure.Env.ok_name("PATH"), true)),
      Test.unit("env ok eq", Test.bool(Sure.Env.ok_name("A=B"), false)),
      Test.unit("env ok nl", Test.bool(Sure.Env.ok_name("A\nB"), false)),
      Test.unit("env decode empty", Test.bool(Outcome.is_ok<Sure.Env.Err, String>(Sure.Env.decode("")), false)),
      Test.unit("env decode missing", Test.bool(Outcome.is_ok<Sure.Env.Err, String>(Sure.Env.decode("1\nmissing")), false)),
      Test.unit("env decode ok",
        case Sure.Env.decode("0\nhi") as o {
          err: Test.Result.fail("err")
          ok: Test.string(o.value, "hi")
        }),
      Test.unit("env decode blank",
        case Sure.Env.decode("0\n") as o {
          err: Test.Result.fail("err")
          ok: Test.string(o.value, "")
        }),
      Test.unit("env parse nat empty", Test.bool(Outcome.is_ok<Sure.Env.Err, Nat>(Sure.Env.parse_nat("")), false)),
      Test.unit("env parse nat junk", Test.bool(Outcome.is_ok<Sure.Env.Err, Nat>(Sure.Env.parse_nat("x")), false)),
      Test.unit("env parse nat zero",
        case Sure.Env.parse_nat("0") as o {
          err: Test.Result.fail("err")
          ok: Test.nat(o.value, 0)
        }),
      Test.unit("env parse bool empty", Test.bool(Outcome.is_ok<Sure.Env.Err, Bool>(Sure.Env.parse_bool("")), false)),
      Test.unit("env parse bool junk", Test.bool(Outcome.is_ok<Sure.Env.Err, Bool>(Sure.Env.parse_bool("yes")), false)),
      Test.unit("env parse bool true",
        case Sure.Env.parse_bool("true") as o {
          err: Test.Result.fail("err")
          ok: Test.bool(o.value, true)
        }),
      Test.unit("env flag empty", Test.bool(Sure.Env.is_flag(""), false)),
      Test.unit("env flag 0", Test.bool(Sure.Env.is_flag("0"), false)),
      Test.unit("env flag false", Test.bool(Sure.Env.is_flag("false"), false)),
      Test.unit("env flag off", Test.bool(Sure.Env.is_flag("off"), false)),
      Test.unit("env flag no", Test.bool(Sure.Env.is_flag("no"), false)),
      Test.unit("env flag 1", Test.bool(Sure.Env.is_flag("1"), true)),
      Test.unit("env keys empty", Test.nat(List.length<String>(Sure.Env.keys_of("")), 0)),
      Test.unit("env keys one", Test.nat(List.length<String>(Sure.Env.keys_of("PATH")), 1)),
      Test.unit("env err empty name", Test.string(Sure.Env.Err.show(Sure.Env.Err.empty_name), "empty_name")),
      Test.unit("cfg ok empty", Test.bool(Sure.Cfg.ok_key(""), false)),
      Test.unit("cfg ok x", Test.bool(Sure.Cfg.ok_key("x"), true)),
      Test.unit("cfg ok nul", Test.bool(Sure.Cfg.ok_key(String.cons(0#16, "")), false)),
      Test.unit("cfg blank empty", Test.bool(Sure.Cfg.blank(""), true)),
      Test.unit("cfg blank space", Test.bool(Sure.Cfg.blank(" \n\t"), true)),
      Test.unit("cfg blank x", Test.bool(Sure.Cfg.blank("x"), false)),
      Test.unit("cfg count empty", Test.nat(Sure.Cfg.count(Sure.Cfg.empty), 0)),
      Test.unit("cfg of null", Test.bool(Maybe.is_none<Sure.Cfg>(Sure.Cfg.of(JSON.null)), true)),
      Test.unit("cfg of arr", Test.bool(Maybe.is_none<Sure.Cfg>(Sure.Cfg.of(JSON.array([]))), true)),
      Test.unit("cfg of bool", Test.bool(Maybe.is_none<Sure.Cfg>(Sure.Cfg.of(JSON.bool(true))), true)),
      Test.unit("cfg read empty",
        case Sure.Cfg.read("") as c {
          none: Test.Result.fail("none")
          some: Test.nat(Sure.Cfg.count(c.value), 0)
        }),
      Test.unit("cfg read space",
        case Sure.Cfg.read(" \n") as c {
          none: Test.Result.fail("none")
          some: Test.nat(Sure.Cfg.count(c.value), 0)
        }),
      Test.unit("cfg read junk", Test.bool(Maybe.is_none<Sure.Cfg>(Sure.Cfg.read("nope")), true)),
      Test.unit("cfg read null", Test.bool(Maybe.is_none<Sure.Cfg>(Sure.Cfg.read("null")), true)),
      Test.unit("cfg read arr", Test.bool(Maybe.is_none<Sure.Cfg>(Sure.Cfg.read("[]")), true)),
      Test.unit("cfg read leftover", Test.bool(Maybe.is_none<Sure.Cfg>(Sure.Cfg.read("{}x")), true)),
      Test.unit("cfg read object",
        case Sure.Cfg.read("{}") as c {
          none: Test.Result.fail("none")
          some: Test.nat(Sure.Cfg.count(c.value), 0)
        }),
      Test.unit("cfg read trail nl",
        case Sure.Cfg.read("{}\n") as c {
          none: Test.Result.fail("none")
          some: Test.nat(Sure.Cfg.count(c.value), 0)
        }),
      Test.unit("cfg get empty", Test.bool(Maybe.is_none<JSON>(Sure.Cfg.get(Sure.Cfg.empty, "")), true)),
      Test.unit("cfg get miss", Test.bool(Maybe.is_none<JSON>(Sure.Cfg.get(Sure.Cfg.empty, "x")), true)),
      Test.unit("cfg get hit",
        case Sure.Cfg.str(Sure.Cfg.put(Sure.Cfg.empty, "x", "y"), "x") as v {
          none: Test.Result.fail("none")
          some: Test.string(v.value, "y")
        }),
      Test.unit("cfg set empty", Test.nat(Sure.Cfg.count(Sure.Cfg.put(Sure.Cfg.empty, "", "x")), 0)),
      Test.unit("cfg get_or empty", Test.string(Sure.Cfg.get_or(Sure.Cfg.empty, "", "d"), "d")),
      Test.unit("cfg get_or miss", Test.string(Sure.Cfg.get_or(Sure.Cfg.empty, "x", "d"), "d")),
      Test.unit("cfg get_or hit", Test.string(Sure.Cfg.get_or(Sure.Cfg.put(Sure.Cfg.empty, "x", "y"), "x", "d"), "y")),
      Test.unit("cfg del empty", Test.nat(Sure.Cfg.count(Sure.Cfg.del(Sure.Cfg.empty, "")), 0)),
      Test.unit("cfg del miss", Test.nat(Sure.Cfg.count(Sure.Cfg.del(Sure.Cfg.empty, "x")), 0)),
      Test.unit("cfg del hit", Test.nat(Sure.Cfg.count(Sure.Cfg.del(Sure.Cfg.put(Sure.Cfg.empty, "x", "y"), "x")), 0)),
      Test.unit("cfg need empty", Test.bool(Outcome.is_ok<Sure.Cfg.Err, JSON>(Sure.Cfg.need(Sure.Cfg.empty, "")), false)),
      Test.unit("cfg need miss", Test.bool(Outcome.is_ok<Sure.Cfg.Err, JSON>(Sure.Cfg.need(Sure.Cfg.empty, "x")), false)),
      Test.unit("cfg nat empty", Test.bool(Maybe.is_none<Nat>(Sure.Cfg.nat(Sure.Cfg.empty, "n")), true)),
      Test.unit("cfg nat junk", Test.bool(Maybe.is_none<Nat>(Sure.Cfg.nat(Sure.Cfg.put(Sure.Cfg.empty, "n", "x"), "n")), true)),
      Test.unit("cfg nat zero",
        case Sure.Cfg.nat(Sure.Cfg.put(Sure.Cfg.empty, "n", "0"), "n") as v {
          none: Test.Result.fail("none")
          some: Test.nat(v.value, 0)
        }),
      Test.unit("cfg bool empty", Test.bool(Maybe.is_none<Bool>(Sure.Cfg.bool(Sure.Cfg.empty, "b")), true)),
      Test.unit("cfg bool 1",
        case Sure.Cfg.bool(Sure.Cfg.put(Sure.Cfg.empty, "b", "1"), "b") as v {
          none: Test.Result.fail("none")
          some: Test.bool(v.value, true)
        }),
      Test.unit("cfg bool 0",
        case Sure.Cfg.bool(Sure.Cfg.put(Sure.Cfg.empty, "b", "0"), "b") as v {
          none: Test.Result.fail("none")
          some: Test.bool(v.value, false)
        }),
      Test.unit("cfg bool junk", Test.bool(Maybe.is_none<Bool>(Sure.Cfg.bool(Sure.Cfg.put(Sure.Cfg.empty, "b", "yes"), "b")), true)),
      Test.unit("cfg flag empty", Test.bool(Sure.Cfg.flag(Sure.Cfg.empty, ""), false)),
      Test.unit("cfg flag 0", Test.bool(Sure.Cfg.flag(Sure.Cfg.put(Sure.Cfg.empty, "x", "0"), "x"), false)),
      Test.unit("cfg flag 1", Test.bool(Sure.Cfg.flag(Sure.Cfg.put(Sure.Cfg.empty, "x", "1"), "x"), true)),
      Test.unit("cfg from cli empty", Test.nat(Sure.Cfg.count(Sure.Cfg.from_cli(Sure.Cli.empty)), 0)),
      Test.unit("cfg from cli eq",
        case Sure.Cfg.str(Sure.Cfg.from_cli(Sure.Cli.parse(["--x=y"])), "x") as v {
          none: Test.Result.fail("none")
          some: Test.string(v.value, "y")
        }),
      Test.unit("cfg from cli flag",
        case Sure.Cfg.bool(Sure.Cfg.from_cli(Sure.Cli.parse(["--x"])), "x") as v {
          none: Test.Result.fail("none")
          some: Test.bool(v.value, true)
        }),
      Test.unit("cfg from cli empty val",
        case Sure.Cfg.str(Sure.Cfg.from_cli(Sure.Cli.parse(["--x="])), "x") as v {
          none: Test.Result.fail("none")
          some: Test.string(v.value, "")
        }),
      Test.unit("cfg from cli last",
        case Sure.Cfg.str(Sure.Cfg.from_cli(Sure.Cli.parse(["--x=1", "--x=2"])), "x") as v {
          none: Test.Result.fail("none")
          some: Test.string(v.value, "2")
        }),
