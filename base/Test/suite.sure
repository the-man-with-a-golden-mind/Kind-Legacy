      Test.unit("is page double sure", Test.bool(Sure.Tweeter.is_page("/Sure.Sure.Tweeter.client.html"), false)),
      Test.unit("is page junk", Test.bool(Sure.Tweeter.is_page("/nope"), false)),
      Test.unit("is login empty", Test.bool(Sure.Tweeter.is_login(""), false)),
      Test.unit("is login hit", Test.bool(Sure.Tweeter.is_login("/tweeter/login?u=a"), true)),
      Test.unit("is upload hit", Test.bool(Sure.Tweeter.is_upload("/tweeter/upload?s=a"), true)),
      Test.unit("is post empty", Test.bool(Sure.Tweeter.is_post(""), false)),
      Test.unit("is post GET", Test.bool(Sure.Tweeter.is_post("GET"), false)),
      Test.unit("is post POST", Test.bool(Sure.Tweeter.is_post("POST"), true)),
      Test.unit("need post empty", Test.bool(Sure.Tweeter.need_post(""), false)),
      Test.unit("need post login", Test.bool(Sure.Tweeter.need_post("/tweeter/login"), true)),
      Test.unit("need post me", Test.bool(Sure.Tweeter.need_post("/tweeter/me"), false)),
      Test.unit("login body", Test.string(Sure.Tweeter.login_body("ada", "x"), "u=ada&p=x")),
      Test.unit("login body empty user", Test.string(Sure.Tweeter.login_body("", "x"), "u=&p=x")),
      Test.unit("tweet body", Test.string(Sure.Tweeter.tweet_body("s", "hi", ""), "s=s&t=hi&f=")),
      Test.unit("cookie sid empty", Test.string(Sure.Tweeter.cookie_sid(""), "")),
      Test.unit("cookie sid junk", Test.string(Sure.Tweeter.cookie_sid("sure_sid=nope"), "")),
      Test.unit("cookie sid hit", Test.string(Sure.Tweeter.cookie_sid("sure_sid=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")),
      Test.unit("cookie sid list", Test.string(Sure.Tweeter.cookie_sid("a=1; sure_sid=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")),
      Test.unit("pick sid body", Test.string(Sure.Tweeter.pick_sid("s=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "/x", ""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")),
      Test.unit("pick sid url", Test.string(Sure.Tweeter.pick_sid("", "/tweeter/me?s=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", ""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")),
      Test.unit("pick sid cookie", Test.string(Sure.Tweeter.pick_sid("", "/tweeter/me", "sure_sid=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")),
      Test.unit("pick sid empty", Test.string(Sure.Tweeter.pick_sid("", "/tweeter/me", ""), "")),
