    Test.io("http.app.step", IO {
      get l = Http.Server.listen(18766)
      case l {
        err: IO { return Test.Result.fail("listen") }
        ok: IO {
          get jid = IO.job_start("http\nGET http://127.0.0.1:18766/user/9\n\n")
          get stepped = Http.App.step(18766, [
            Http.App.get("/user/:id", (req, binds)
              IO {
                return Http.json(Http.Path.lookup("id", binds))
              })
          ])
          get cres = IO.job_await(jid)
          Http.Server.stop(18766)
          if Bool.not(stepped) then
            IO { return Test.Result.fail("step") }
          else IO {
            let dec = Http.decode(cres)
            return case dec {
              err: Test.Result.fail("client")
              ok: Test.string(dec.value@body, "9")
            }
          }
        }
      }
    }),
    Test.io("http.server.roundtrip", IO {
      get l = Http.Server.listen(18765)
      case l {
        err: IO {
          return Test.Result.fail("listen")
        }
        ok: IO {
          get jid = IO.job_start("http\nGET http://127.0.0.1:18765/ping\n\n")
          get raw = Http.Server.recv(18765)
          let parsed = Http.Server.parse(raw)
          case parsed {
            none: IO {
              Http.Server.stop(18765)
              return Test.Result.fail("recv")
            }
            some: IO {
              open parsed.value
              Http.Server.reply(parsed.value.id, 200, "pong")
              get cres = IO.job_await(jid)
              Http.Server.stop(18765)
              let dec = Http.decode(cres)
              return case dec {
                err: Test.Result.fail("client")
                ok: Test.string(dec.value@body, "pong")
              }
            }
          }
        }
      }
    }),
    Test.group("Semver", [
