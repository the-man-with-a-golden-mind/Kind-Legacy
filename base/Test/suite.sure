      Test.unit("read feed junk", Test.nat(List.length<Sure.Tweeter.Tweet>(Sure.Tweeter.read_feed("nope")), 0)),
      Test.unit("read feed ok", Test.nat(List.length<Sure.Tweeter.Tweet>(Sure.Tweeter.read_feed("ok")), 0)),
      Test.unit("read feed one", Test.nat(List.length<Sure.Tweeter.Tweet>(Sure.Tweeter.read_feed("ok ada~hi~")), 1)),
      Test.unit("show feed nil", Test.string(Sure.Tweeter.show_feed([]), "ok")),
      Test.unit("read sid junk", Test.bool(Maybe.is_none<String>(Sure.Tweeter.read_sid("nope")), true)),
      Test.unit("read sid empty", Test.bool(Maybe.is_none<String>(Sure.Tweeter.read_sid("")), true)),
      Test.unit("read err empty", Test.string(Sure.Tweeter.read_err(""), "empty")),
      Test.unit("read err", Test.string(Sure.Tweeter.read_err("err taken"), "taken")),
      Test.unit("init user", Test.string(Sure.Tweeter.user_of(Sure.Tweeter.init), "")),
      Test.unit("init sess",
