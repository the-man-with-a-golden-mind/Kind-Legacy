    ]),
    Test.io("file.roundtrip", IO {
      File.with_temp<Test.Result>((p)
        IO {
          get w = File.write(p, "hi=there")
          get r = File.read(p)
          return case w r {
            ok ok: Test.string(r.value, "hi=there")
          } default Test.Result.fail("roundtrip")
        })
    }),
    Test.io("file.missing", IO {
      get r = File.read(Path.unsafe(".cache/kind_no_such_file_zz.txt"))
      return case r {
        err:
          case r.error {
            missing: Test.Result.pass
          } default Test.Result.fail("expected missing")
        ok: Test.Result.fail("should be missing")
      }
    }),
    Test.io("file.bad_path", IO {
