    Test.io("task.all.two", IO {
      get xs = Task.all<Nat>([IO.end<Nat>(1), IO.end<Nat>(2)])
      return case xs {
        nil: Test.Result.fail("nil")
        cons:
          case xs.tail {
            nil: Test.Result.fail("one")
            cons: Test.nat(Nat.add(xs.head, xs.tail.head), 3)
          }
      }
    }),
    Test.io("task.race.ends", IO {
      get x = Task.race<Nat>(IO.end<Nat>(7), IO.end<Nat>(7))
      return Test.nat(x, 7)
    }),
    Test.io("task.race.fast", IO {
      get x = Task.race<Nat>(IO.end<Nat>(3), IO {
        IO.sleep(80)
        return 9
      })
      return Test.nat(x, 3)
    }),
    Test.io("par.map.empty", IO {
      get xs = Sure.Par.map<Nat, Nat>(Nat.succ, [])
      return Test.nat(List.length<Nat>(xs), 0)
    }),
    Test.io("par.map.one", IO {
      get xs = Sure.Par.map<Nat, Nat>(Nat.succ, [0])
      return case xs {
        nil: Test.Result.fail("nil")
        cons: Test.nat(xs.head, 1)
      }
    }),
    Test.io("par.pair", IO {
      get p = Sure.Par.pair<Nat, Nat>((u) 1, (u) 2)
      open p
      return Test.nat(Nat.add(p.fst, p.snd), 3)
    }),
    Test.io("job.all.empty", IO {
      get w = IO.job_all("")
      return Test.string(w, "0\n")
    }),
    Test.io("job.race.empty", IO {
      get w = IO.job_race("")
      return Test.string(w, "1")
    }),
    Test.io("compress.gzip", IO {
      get z = Compress.gzip("hi")
      case z {
        err: IO { return Test.Result.fail("gzip") }
        ok: IO {
          get p = Compress.gunzip(z.value)
          return case p {
            err: Test.Result.fail("gunzip")
            ok: Test.string(p.value, "hi")
          }
        }
      }
    }),
    Test.io("net.tcp.refused", IO {
      get r = Net.connect("127.0.0.1", 1, false)
      return case r {
        err: Test.Result.pass
        ok: Test.Result.fail("expected refuse")
      }
    }),
    Test.io("net.dns.localhost", IO {
      get r = Net.dns("localhost")
      return case r {
        ok: Test.assert(Bool.not(String.is_empty(r.value)), "empty dns")
        err: Test.Result.fail("dns")
      }
    }),
    Test.io("host.env", IO {
      get p = IO.get_env("PATH")
      return case p {
        none: Test.Result.fail("PATH unset")
        some: Test.assert(Bool.not(String.is_empty(p.value)), "PATH empty")
      }
    }),
    Test.io("host.env.missing", IO {
      get p = IO.get_env("SURE_NO_SUCH_ENV_ZZ")
      return case p {
        none: Test.Result.pass
        some: Test.Result.fail("expected unset")
      }
    }),
    Test.io("file.empty", IO {
      File.with_temp<Test.Result>((p)
        IO {
          get w = File.write(p, "")
          get r = File.read(p)
          return case w r {
            ok ok: Test.string(r.value, "")
          } default Test.Result.fail("empty file")
        })
    }),
    Test.io("proc.exec.fail", IO {
      get o = Proc.exec("node -e \"process.exit(2)\"")
      return case o {
        ok: Test.Result.fail("expected fail")
        err: Test.Result.pass
      }
    }),
    Test.io("ffi.empty", IO {
      get o = Ffi.call("", JSON.null)
      return case o as r {
        err: Test.string(Ffi.Err.show(r.error), "empty_name")
        ok: Test.Result.fail("ok")
      }
    }),
    Test.io("ffi.missing", IO {
      get o = Ffi.call("Sure.NoSuch.Ffi", JSON.null)
      return case o as r {
        err: Test.string(Ffi.Err.show(r.error), "missing")
        ok: Test.Result.fail("ok")
      }
    }),
    Test.io("ffi.add", IO {
      get o = Ffi.call_nat("Sure.ffi.add", [2, 3])
      return case o as r {
        err: Test.Result.fail(Ffi.Err.show(r.error))
        ok: Test.nat(r.value, 5)
      }
    }),
    Test.io("ffi.boom", IO {
      get o = Ffi.call("Sure.ffi.boom", JSON.null)
      return case o as r {
        err: Test.string(Ffi.Err.show(r.error), "throw:boom")
        ok: Test.Result.fail("ok")
      }
    }),
    Test.io("ffi.bad_json", IO {
      get raw = IO.ask<String>("ffi", "Sure.ffi.add\n{", (t) IO.end<String>(t))
      return case Ffi.decode(raw) as r {
        err: Test.string(Ffi.Err.show(r.error), "bad_json")
        ok: Test.Result.fail("ok")
      }
    }),
    Test.io("ffi.bad_name", IO {
      get o = Ffi.call("a/b", JSON.null)
      return case o as r {
        err: Test.string(Ffi.Err.show(r.error), "bad_name")
        ok: Test.Result.fail("ok")
      }
    }),
    Test.io("worker.empty", IO {
      get o = Worker.run("", JSON.null)
      return case o as r {
        err: Test.string(Worker.Err.show(r.error), "empty_name")
        ok: Test.Result.fail("ok")
      }
    }),
    Test.io("worker.bad_name", IO {
      get o = Worker.run("a/b", JSON.null)
      return case o as r {
        err: Test.string(Worker.Err.show(r.error), "bad_name")
        ok: Test.Result.fail("ok")
      }
    }),
    Test.io("worker.missing", IO {
      get o = Worker.run("Sure.NoSuch.Worker", JSON.null)
      return case o as r {
        err: Test.string(Worker.Err.show(r.error), "missing")
        ok: Test.Result.fail("ok")
      }
    }),
    Test.io("worker.add", IO {
      get o = Worker.run_nat("Sure.ffi.add", [2, 3])
      return case o as r {
        err: Test.Result.fail(Worker.Err.show(r.error))
        ok: Test.nat(r.value, 5)
      }
    }),
    Test.io("worker.double", IO {
      get o = Worker.run_nat("Sure.worker.double", [21])
      return case o as r {
        err: Test.Result.fail(Worker.Err.show(r.error))
        ok: Test.nat(r.value, 42)
      }
    }),
    Test.io("worker.boom", IO {
      get o = Worker.run("Sure.ffi.boom", JSON.null)
      return case o as r {
        err: Test.string(Worker.Err.show(r.error), "throw:boom")
        ok: Test.Result.fail("ok")
      }
    }),
    Test.io("worker.bad_json", IO {
      get raw = IO.ask<String>("worker_run", "Sure.ffi.add\n{", (t) IO.end<String>(t))
      return case Worker.decode(raw) as r {
        err: Test.string(Worker.Err.show(r.error), "bad_json")
        ok: Test.Result.fail("ok")
      }
    }),
    Test.io("worker.map.empty", IO {
      get o = Worker.map("Sure.worker.double", [])
      return case o as r {
        err: Test.Result.fail(Worker.Err.show(r.error))
        ok: Test.nat(List.length<JSON>(r.value), 0)
      }
    }),
    Test.io("worker.map.two", IO {
      get o = Worker.map("Sure.worker.double", [JSON.enc.nat(1), JSON.enc.nat(2)])
      return case o as r {
        err: Test.Result.fail(Worker.Err.show(r.error))
        ok: Test.nat(List.length<JSON>(r.value), 2)
      }
    }),
    Test.group("Net.tcp.decode", [
      Test.unit("conn err", Test.bool(Outcome.is_ok<Net.Err, Net.Conn>(Net.decode_conn("1\nbad host")), false)),
      Test.unit("conn empty", Test.bool(Outcome.is_ok<Net.Err, Net.Conn>(Net.decode_conn("")), false)),
      Test.unit("conn untagged", Test.bool(Outcome.is_ok<Net.Err, Net.Conn>(Net.decode_conn("nope")), false)),
      Test.unit("conn tls", Test.bool(Outcome.is_ok<Net.Err, Net.Conn>(Net.decode_conn("1\nnot implemented")), false)),
      Test.unit("conn ok id",
        case Net.decode_conn("0\n1") as o {
          err: Test.Result.fail("err")
          ok: Test.string(o.value@id, "1")
        }),
      Test.unit("closed", Test.bool(Outcome.is_ok<Net.Err, Unit>(Net.decode_unit("1\nclosed")), false)),
      Test.unit("unit empty", Test.bool(Outcome.is_ok<Net.Err, Unit>(Net.decode_unit("")), false)),
      Test.unit("param plain", Test.string("127.0.0.1" | "\n" | "80" | "\n" | "0", "127.0.0.1\n80\n0")),
    ]),
    Test.group("Net.udp.parse", [
      Test.unit("empty one", Test.bool(Maybe.is_none<Net.Udp.Msg>(Net.udp.parse_one("")), true)),
      Test.unit("short", Test.bool(Maybe.is_none<Net.Udp.Msg>(Net.udp.parse_one("1.2.3.4,1")), true)),
      Test.unit("ok", Test.bool(Maybe.is_none<Net.Udp.Msg>(Net.udp.parse_one("127.0.0.1,9,68")), false)),
      Test.unit("all empty", Test.nat(List.length<Net.Udp.Msg>(Net.udp.parse_all("")), 0)),
      Test.unit("decode err", Test.bool(Outcome.is_ok<Net.Err, List<Net.Udp.Msg>>(Net.udp.decode("1\nbad")), false)),
      Test.unit("decode bad tag", Test.bool(Outcome.is_ok<Net.Err, List<Net.Udp.Msg>>(Net.udp.decode("nope")), false)),
      Test.unit("decode closed", Test.bool(Outcome.is_ok<Net.Err, List<Net.Udp.Msg>>(Net.udp.decode("1\nclosed")), false)),
      Test.unit("decode bad port", Test.bool(Outcome.is_ok<Net.Err, List<Net.Udp.Msg>>(Net.udp.decode("1\nbad port")), false)),
    ]),
    Test.io("udp.empty", IO {
      get b = Net.udp.bind(18780)
      case b {
        err: IO { return Test.Result.fail("bind") }
        ok: IO {
          get r = Net.udp.recv(18780)
          Net.udp.close(18780)
          return case r {
            err: Test.Result.fail("recv")
            ok: Test.nat(List.length<Net.Udp.Msg>(r.value), 0)
          }
        }
      }
    }),
    Test.io("udp.loopback", IO {
      get b = Net.udp.bind(18781)
      case b {
        err: IO { return Test.Result.fail("bind") }
        ok: IO {
          get s = Net.udp.send_text(18781, "127.0.0.1", 18781, "hi")
          IO.sleep(40)
          get r = Net.udp.recv(18781)
          Net.udp.close(18781)
          return case s r {
            err err: Test.Result.fail("send/recv")
            err ok: Test.Result.fail("send")
            ok err: Test.Result.fail("recv")
            ok ok:
              case r.value as xs {
                nil: Test.Result.fail("empty mail")
                cons: Test.string(xs.head@data, String.hex.encode.ascii("hi"))
              }
          }
        }
      }
    }),
    Test.io("udp.bad_port", IO {
      get b = Net.udp.bind(70000)
      return case b {
        ok: Test.Result.fail("expected bad port")
        err: Test.Result.pass
      }
    }),
    Test.io("udp.bad_dest", IO {
      get s = Net.udp.send(18782, "", 18782, "00")
      return case s {
        ok: Test.Result.fail("expected bad dest")
        err: Test.Result.pass
      }
    }),
    Test.io("udp.recv.closed", IO {
      get r = Net.udp.recv(19991)
      return case r {
        ok: Test.Result.fail("expected closed")
        err: Test.Result.pass
      }
    }),
    Test.io("udp.send.closed", IO {
      get s = Net.udp.send(19992, "127.0.0.1", 19992, "00")
      return case s {
        ok: Test.Result.fail("expected closed")
        err: Test.Result.pass
      }
    }),
    Test.group("Crypto", [
      Test.unit("hex empty", Test.bool(Crypto.is_hex(""), true)),
      Test.unit("hex bad", Test.bool(Crypto.is_hex("gg"), false)),
      Test.unit("hex64 empty", Test.bool(Crypto.hex64(""), false)),
      Test.unit("hex64 abc", Test.bool(Crypto.hex64(Crypto.sha256.abc_hex), true)),
      Test.unit("decode err", Test.bool(Outcome.is_ok<Crypto.Err, String>(Crypto.decode("1\nbad")), false)),
      Test.unit("decode short", Test.bool(Outcome.is_ok<Crypto.Err, String>(Crypto.decode("0\nab")), false)),
    ]),
    Test.io("crypto.sha256.abc", IO {
      get h = Crypto.sha256("abc")
      return case h {
        err: Test.Result.fail("sha256")
        ok: Test.string(h.value, Crypto.sha256.abc_hex)
      }
    }),
    Test.io("crypto.sha256.empty", IO {
      get h = Crypto.sha256("")
      return case h {
        err: Test.Result.fail("sha256 empty")
        ok: Test.string(h.value, Crypto.sha256.empty_hex)
      }
    }),
    Test.io("crypto.hmac.empty", IO {
      get h = Crypto.hmac_sha256("", "")
      return case h {
        err: Test.Result.fail("hmac empty")
        ok: Test.string(h.value, Crypto.hmac.empty_hex)
      }
    }),
    Test.io("crypto.hmac.jefe", IO {
      get h = Crypto.hmac_sha256("Jefe", "what do ya want for nothing?")
      return case h {
        err: Test.Result.fail("hmac jefe")
        ok: Test.string(h.value, Crypto.hmac.jefe_hex)
      }
    }),
    Test.io("compress.empty", IO {
      get z = Compress.gzip("")
      case z {
        err: IO { return Test.Result.fail("gzip empty") }
        ok: IO {
          get p = Compress.gunzip(z.value)
          return case p {
            err: Test.Result.fail("gunzip empty")
            ok: Test.string(p.value, "")
          }
        }
      }
    }),
    Test.group("Cover.done", [
      Test.unit("match junk method",
        Test.bool(Maybe.is_none<List<Pair<String, String>>>(Http.App.match(Http.Method.get, "/", Http.Server.Req.new("", "NOPE", "/", "", ""))), true)),
      Test.unit("match empty method",
        Test.bool(Maybe.is_none<List<Pair<String, String>>>(Http.App.match(Http.Method.get, "/", Http.Server.Req.new("", "", "/", "", ""))), true)),
      Test.unit("match miss post",
        Test.bool(Maybe.is_none<List<Pair<String, String>>>(Http.App.match(Http.Method.get, "/", Http.Server.Req.new("", "POST", "/", "", ""))), true)),
      Test.unit("match hit slash",
        Test.bool(Maybe.is_none<List<Pair<String, String>>>(Http.App.match(Http.Method.get, "/", Http.Server.Req.new("", "GET", "/", "", ""))), false)),
      Test.unit("match empty url",
        Test.bool(Maybe.is_none<List<Pair<String, String>>>(Http.App.match(Http.Method.get, "/x", Http.Server.Req.new("", "GET", "", "", ""))), true)),
      Test.unit("get miss post",
        Test.bool(Maybe.is_none<List<Pair<String, String>>>(Http.Server.get("/", Http.Server.Req.new("", "POST", "/", "", ""))), true)),
      Test.unit("get miss empty",
        Test.bool(Maybe.is_none<List<Pair<String, String>>>(Http.Server.get("/", Http.Server.Req.new("", "", "/", "", ""))), true)),
      Test.unit("get hit",
        Test.bool(Maybe.is_none<List<Pair<String, String>>>(Http.Server.get("/", Http.Server.Req.new("", "GET", "/", "", ""))), false)),
      Test.unit("get lowercase",
        Test.bool(Maybe.is_none<List<Pair<String, String>>>(Http.Server.get("/", Http.Server.Req.new("", "get", "/", "", ""))), false)),
      Test.unit("post miss get",
        Test.bool(Maybe.is_none<List<Pair<String, String>>>(Http.Server.post("/", Http.Server.Req.new("", "GET", "/", "", ""))), true)),
      Test.unit("post miss empty",
        Test.bool(Maybe.is_none<List<Pair<String, String>>>(Http.Server.post("/", Http.Server.Req.new("", "", "/", "", ""))), true)),
      Test.unit("post hit",
        Test.bool(Maybe.is_none<List<Pair<String, String>>>(Http.Server.post("/", Http.Server.Req.new("", "POST", "/", "", ""))), false)),
      Test.unit("post lowercase",
        Test.bool(Maybe.is_none<List<Pair<String, String>>>(Http.Server.post("/", Http.Server.Req.new("", "post", "/", "", ""))), false)),
      Test.unit("cfg pad parser", Test.nat(List.length<Parser<List<Unit>>>([Sure.Cfg.pad]), 1)),
      Test.unit("reply html", Test.nat(List.length<(String) -> (String) -> IO<Unit>>([Http.Server.reply_html]), 1)),
    ]),
    Test.group("Sure.Web", [
      Test.unit("draw 0", Test.nat(Sure.Web.html_draw(0), 0)),
      Test.unit("step 0 keeps", Test.nat(Sure.Web.html_step(0, 7), 7)),
      Test.unit("step 3 inc", Test.nat(Sure.Web.html_step(3, 0), 3)),
      Test.unit("step junk keeps", Test.nat(Sure.Web.html_step_junk(5, 4), 4)),
      Test.unit("ui step 0", Test.nat(Sure.Web.ui_step(0), 0)),
      Test.unit("ui step 2", Test.nat(Sure.Web.ui_step(2), 2)),
      Test.unit("ssr doc 0", Test.nat(Sure.Web.ssr_doc(0), 0)),
      Test.unit("ssr nf 0", Test.nat(Sure.Web.ssr_nf(0), 0)),
      Test.unit("escape empty 2", Test.nat(Sure.Web.escape_empty(2), 0)),
      Test.unit("escape junk 1", Test.bool(Nat.gtn(Sure.Web.escape_junk(1), 0), true)),
      Test.unit("match junk 3", Test.nat(Sure.Web.match_junk(3), 0)),
      Test.unit("match hit 3", Test.nat(Sure.Web.match_hit(3), 3)),
      Test.unit("sheet win 0", Test.nat(Sure.Web.sheet_win(0), 0)),
      Test.unit("window empty", Test.nat(Sure.Web.window_count(0, 0), 0)),
      Test.unit("window 10k is virtual", Test.bool(Nat.ltn(Sure.Web.window_count(0, Nat.read("10000")), Nat.read("10000")), true)),
      Test.unit("show empty", Test.string(Sure.Web.show(Sure.Web.Sample.new("", 0, 0)), "  work=0  ms=0")),
      Test.unit("draw 2 checksum", Test.bool(Nat.gtn(Sure.Web.html_draw(2), 0), true)),
      Test.unit("ssr doc 1 checksum", Test.bool(Nat.gtn(Sure.Web.ssr_doc(1), 0), true)),
    ]),
    Test.io("web.fire.nil.1", IO {
      get n = Sure.Web.fire_nil_n(1)
      return Test.nat(n, 404)
    }),
    Test.io("web.ssr.fire.nil.1", IO {
