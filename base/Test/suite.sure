          get h = Db.has(c.value, "k")
          get ks = Db.keys(c.value)
          get d = Db.del(c.value, "k")
          get h2 = Db.has(c.value, "k")
          get z = Db.clear(c.value)
          Db.close(c.value)
          return case w h ks d h2 z {
            ok ok ok ok ok ok:
              Test.assert(Bool.and(h.value, Bool.not(h2.value)), "has")
          } default Test.Result.fail("ops")
        }
