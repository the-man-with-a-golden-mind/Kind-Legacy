    Test.io("dsl mig roundtrip", IO {
      get o = Db.with<Nat>("suremem:ssr-mig-test", (c)
        IO {
          case Db.Mig.step("a", [Db.Dsl.set("k", "v")], [Db.Dsl.del("k")]) as st {
            none: IO { return Outcome.err<Db.Err, Nat>(Db.Err.empty_key) }
            some: IO {
              get n = Db.Mig.up(c, [st.value])
              get g = Db.get(c, "k")
              get n2 = Db.Mig.up(c, [st.value])
              get d = Db.Mig.down(c, [st.value])
              get g2 = Db.get(c, "k")
              return case n n2 d {
                ok ok ok:
                  if Bool.not(Nat.eql(n.value, 1)) then Outcome.err<Db.Err, Nat>(Db.Err.io("up1"))
                  else if Bool.not(Nat.eql(n2.value, 0)) then Outcome.err<Db.Err, Nat>(Db.Err.io("up0"))
                  else if Bool.not(Nat.eql(d.value, 1)) then Outcome.err<Db.Err, Nat>(Db.Err.io("down"))
                  else case g g2 {
                    ok err: Outcome.ok<Db.Err, Nat>(0)
                  } default Outcome.err<Db.Err, Nat>(Db.Err.io("row"))
              } default Outcome.err<Db.Err, Nat>(Db.Err.io("mig"))
            }
          }
        })
      return case o as r {
        err: Test.Result.fail(Db.Err.show(r.error))
        ok: Test.nat(r.value, 0)
      }
    }),
    Test.io("dsl prefix", IO {
      get o = Db.with<Nat>("suremem:ssr-dsl-test", (c)
        IO {
          get s = Db.set(c, "user/1", "a")
          get s2 = Db.set(c, "post/1", "b")
          get r = Db.Dsl.exec(c, "PREFIX user/")
          return case r {
            err: Outcome.err<Db.Err, Nat>(r.error)
            ok:
              case r.value {
                list: Outcome.ok<Db.Err, Nat>(List.length<String>(r.value.value))
              } default Outcome.err<Db.Err, Nat>(Db.Err.io("not list"))
          }
        })
      return case o as r {
        err: Test.Result.fail(Db.Err.show(r.error))
        ok: Test.nat(r.value, 1)
      }
    }),
    Test.io("host.state", IO {
      IO.set_state("prove", "ok")
      get got = IO.get_state("prove")
      return case got {
        none: Test.Result.fail("missing")
        some: Test.string(got.value, "ok")
      }
    }),
    Test.group("Host", [
      Test.unit("decode empty",
        case Host.decode("") {
          ok_string: Test.Result.fail("string")
          ok_unit: Test.Result.pass
          err: Test.Result.fail("err")
        }),
      Test.unit("decode ok empty",
        case Host.decode("0\n") as e {
          ok_string: Test.string(e.value, "")
          ok_unit: Test.Result.fail("unit")
          err: Test.Result.fail("err")
        }),
      Test.unit("decode junk",
        case Host.decode("nope") as e {
          ok_string: Test.string(e.value, "nope")
          ok_unit: Test.Result.fail("unit")
          err: Test.Result.fail("err")
        }),
      Test.unit("decode missing",
        case Host.decode("1\nmissing") as e {
          ok_string: Test.Result.fail("ok")
          ok_unit: Test.Result.fail("unit")
          err: Test.string(Host.Err.show(e.error), "missing")
        }),
      Test.unit("decode err empty",
        case Host.decode("1\n") as e {
          ok_string: Test.Result.fail("ok")
          ok_unit: Test.Result.fail("unit")
          err: Test.string(Host.Err.show(e.error), "empty")
