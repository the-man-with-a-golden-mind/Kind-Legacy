    Test.io("env empty value", IO {
      get s = Sure.Env.set("SURE_ENV_TEST", "")
      get g = Sure.Env.get("SURE_ENV_TEST")
      get d = Sure.Env.del("SURE_ENV_TEST")
      get m = Sure.Env.get("SURE_ENV_TEST")
      return case s {
        err: Test.Result.fail("set")
        ok:
          case g {
            err: Test.Result.fail("get empty")
            ok:
              if Bool.not(String.is_empty(g.value)) then Test.Result.fail("not empty")
              else case m {
                ok: Test.Result.fail("not deleted")
                err: Test.string(Sure.Env.Err.show(m.error), "missing")
              }
          }
      }
    }),
    Test.io("env roundtrip", IO {
      get s = Sure.Env.set("SURE_ENV_TEST", "ada")
      get g = Sure.Env.get("SURE_ENV_TEST")
      get n = Sure.Env.nat("SURE_ENV_TEST")
      get h = Sure.Env.has("SURE_ENV_TEST")
      get f = Sure.Env.flag("SURE_ENV_TEST")
      get o = Sure.Env.get_or("SURE_NO_SUCH_ENV_ZZ", "def")
      get d = Sure.Env.del("SURE_ENV_TEST")
      return case s g {
        err err: Test.Result.fail("set")
        err ok: Test.Result.fail("set")
        ok err: Test.Result.fail("get")
        ok ok:
          if Bool.not(String.eql(g.value, "ada")) then Test.Result.fail("val")
          else if Bool.not(h) then Test.Result.fail("has")
          else if Bool.not(f) then Test.Result.fail("flag")
          else if Bool.not(String.eql(o, "def")) then Test.Result.fail("or")
          else case n {
            ok: Test.Result.fail("nat junk")
            err: Test.string(Sure.Env.Err.show(n.error), "junk")
          }
      }
    }),
