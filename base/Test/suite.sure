      return Test.assert(Bool.not(String.is_empty(c)), "empty cwd")
    }),
    Test.io("http.decode", IO {
      let o = Http.decode("0\n200\nok")
      return case o {
        ok: Test.nat(o.value@status, 200)
        err: Test.Result.fail("decode")
      }
    }),
    Test.group("JSON", [
      Test.unit("stringify null", Test.string(JSON.stringify(JSON.null), "null")),
      Test.unit("stringify true", Test.string(JSON.stringify(JSON.bool(true)), "true")),
      Test.unit("parse null",
        case JSON.parse("null") {
          some: Test.assert(true, "ok")
          none: Test.Result.fail("parse null")
        }),
      Test.unit("parse empty", Test.bool(Maybe.is_none<JSON>(JSON.parse("")), true)),
      Test.unit("parse junk", Test.bool(Maybe.is_none<JSON>(JSON.parse("{")), true)),
      Test.unit("field on null", Test.string(JSON.field_string(JSON.null, "name"), "")),
    ]),
    Test.io("task.race", IO {
      get w = Task.race_sleep(10, 80)
      return Test.nat(w, 0)
    }),
    Test.io("task.par", IO {
      get t0 = IO.get_time
      Task.par_sleep(80, 80)
      get t1 = IO.get_time
      let dt = Nat.sub(t1, t0)
      return Test.assert(Nat.ltn(dt, 140), "sequential? dt=" | Nat.show(dt))
    }),
    Test.group("Http.Path", [
      Test.unit("bound id", Test.string(Http.Path.bound("/user/:id", "/user/42", "id"), "42")),
      Test.unit("miss", Test.string(Http.Path.bound("/user/:id", "/post/1", "id"), "")),
      Test.unit("query stripped", Test.string(Http.Path.bound("/ping", "/ping?x=1", "x"), "")),
      Test.unit("empty url", Test.string(Http.Path.bound("/user/:id", "", "id"), "")),
      Test.unit("short url", Test.string(Http.Path.bound("/user/:id", "/user", "id"), "")),
      Test.unit("slash only", Test.string(Http.Path.bound("/user/:id", "/user/", "id"), "")),
      Test.unit("wrong name", Test.string(Http.Path.bound("/user/:id", "/user/1", "nope"), "")),
      Test.unit("empty name", Test.string(Http.Path.bound("/user/:id", "/user/1", ""), "")),
    ]),
