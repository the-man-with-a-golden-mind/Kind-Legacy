      Test.unit("ok data junk", Test.bool(Sure.Tweeter.ok_data("hello"), false)),
      Test.unit("ok data png", Test.bool(Sure.Tweeter.ok_data("data:image/png;base64,AA"), true)),
      Test.unit("ok file id empty", Test.bool(Sure.Tweeter.ok_file_id(""), true)),
      Test.unit("ok file id junk", Test.bool(Sure.Tweeter.ok_file_id("nope"), false)),
