    Test.io("file.delete.hit", IO {
      File.with_temp<Test.Result>((p)
        IO {
          get w = File.write(p, "x")
          get d = File.delete(p)
          get r = File.read(p)
          return case w d r {
            ok ok err:
              case r.error {
                missing: Test.Result.pass
              } default Test.Result.fail("expected missing after delete")
          } default Test.Result.fail("delete hit")
        })
    }),
