      Test.unit("method miss", Test.string(Http.App.hit(Http.Method.get, "/x", "POST", "/x", "id"), "")),
      Test.unit("empty url", Test.string(Http.App.hit(Http.Method.get, "/user/:id", "GET", "", "id"), "")),
      Test.unit("get is GET",
        Test.assert(Http.Method.eql(Http.App.get("/x", Http.App.dummy)@method, Http.Method.get), "not GET")),
