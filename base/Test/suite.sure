      Test.unit("lt patch", Test.bool(Semver.lt(Semver.new(1, 0, 0), Semver.new(1, 0, 1)), true)),
      Test.unit("lt eq", Test.bool(Semver.lt(Semver.new(1, 0, 0), Semver.new(1, 0, 0)), false)),
      Test.unit("parse empty", Test.bool(Maybe.is_none<Semver>(Semver.parse("")), true)),
      Test.unit("parse one", Test.bool(Maybe.is_none<Semver>(Semver.parse("1")), true)),
      Test.unit("parse two", Test.bool(Maybe.is_none<Semver>(Semver.parse("1.2")), true)),
    ]),
