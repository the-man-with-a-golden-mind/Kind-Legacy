      Test.unit("init feed", Test.nat(List.length<Sure.Tweeter.Tweet>(Sure.Tweeter.feed_of(Sure.Tweeter.init)), 0)),
      Test.unit("boot me", Test.string(Sure.Ui.boot_of<Sure.Tweeter.Model>(Sure.Tweeter.client), "H\n/tweeter/me\nrestore")),
      Test.unit("listen none", Test.string(Sure.Ui.listen_of<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Tweeter.init), "")),
      Test.unit("miss", Test.string(Sure.Tweeter.note_of(Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("click", "nope", "", ""), Sure.Tweeter.init)), "")),
      Test.unit("login empty user", Test.string(Sure.Tweeter.note_of(Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("click", "login", "", ""), Sure.Tweeter.init)), "empty_user")),
      Test.unit("register empty user", Test.string(Sure.Tweeter.note_of(Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("click", "register", "", ""), Sure.Tweeter.init)), "empty_user")),
      Test.unit("tweet no session", Test.string(Sure.Tweeter.note_of(Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("click", "tweet", "", ""), Sure.Tweeter.init)), "no_session")),
      Test.unit("file empty", Test.string(Sure.Tweeter.note_of(Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("change", "file", "", ""), Sure.Tweeter.init)), "empty_file")),
      Test.unit("file junk", Test.string(Sure.Tweeter.note_of(Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("change", "file", "", "nope"), Sure.Tweeter.init)), "bad_file")),
      Test.unit("file png", Test.string(Sure.Tweeter.blob_of(Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("change", "file", "", "data:image/png;base64,AA"), Sure.Tweeter.init)), "data:image/png;base64,AA")),
      Test.unit("user set", Test.string(Sure.Tweeter.user_of(Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("change", "user", "", "ada"), Sure.Tweeter.init)), "ada")),
      Test.unit("login empty pass",
        let a = Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("change", "user", "", "ada"), Sure.Tweeter.init)
        Test.string(Sure.Tweeter.note_of(Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("click", "login", "", ""), a)), "empty_pass")),
      Test.unit("login fx",
        let a = Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("change", "user", "", "ada"), Sure.Tweeter.init)
        let b = Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("change", "pass", "", "x"), a)
        let fx = Sure.Ui.step_fx<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("click", "login", "", ""), b)
        if Bool.not(String.starts_with(fx, "O\n/tweeter/login\n")) then Test.Result.fail(fx)
        else if String.includes(fx, "/tweeter/login?") then Test.Result.fail(fx)
        else if Bool.not(String.includes(fx, "u=ada&p=x")) then Test.Result.fail(fx)
        else Test.assert(true, "ok")),
      Test.unit("register fx post",
        let a = Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("change", "user", "", "ada"), Sure.Tweeter.init)
        let b = Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("change", "pass", "", "x"), a)
        Test.bool(String.starts_with(Sure.Ui.step_fx<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("click", "register", "", ""), b), "O\n/tweeter/register\n"), true)),
      Test.unit("authed junk", Test.string(Sure.Tweeter.note_of(Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("http", "authed", "", "nope"), Sure.Tweeter.init)), "junk")),
      Test.unit("authed err", Test.string(Sure.Tweeter.note_of(Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("http", "authed", "", "err taken"), Sure.Tweeter.init)), "taken")),
      Test.unit("restore junk silent", Test.string(Sure.Tweeter.note_of(Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("http", "restore", "", "err no_session"), Sure.Tweeter.init)), "")),
      Test.unit("restore empty silent",
        case Sure.Tweeter.sess_of(Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("http", "restore", "", ""), Sure.Tweeter.init)) {
          none: Test.assert(true, "ok")
          some: Test.Result.fail("sess")
        }),
      Test.unit("restore hit",
        let m = Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("http", "restore", "", "ok e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855 ada"), Sure.Tweeter.init)
        Test.string(Sure.Tweeter.user_of(m), "ada")),
      Test.unit("logout idle",
        case Sure.Tweeter.sess_of(Sure.Ui.step_model<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Ui.wire("click", "logout", "", ""), Sure.Tweeter.init)) {
          none: Test.assert(true, "ok")
          some: Test.Result.fail("sess")
        }),
      Test.unit("draw login", Test.bool(String.includes(Sure.Ui.draw_of<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Tweeter.init), "Login"), true)),
      Test.unit("draw daisy", Test.bool(String.includes(Sure.Ui.draw_of<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Tweeter.init), "card"), true)),
      Test.unit("draw no style", Test.bool(String.includes(Sure.Ui.draw_of<Sure.Tweeter.Model>(Sure.Tweeter.client, Sure.Tweeter.init), " style=\""), false)),
      Test.unit("draw file url", Test.bool(String.includes(Sure.Tweeter.file_url("ab"), "/tweeter/file?id=ab"), true)),
      Test.unit("hdr sess empty", Test.bool(String.includes(Sure.Tweeter.hdr_sess(""), "Set-Cookie"), false)),
      Test.unit("hdr sess", Test.bool(String.includes(Sure.Tweeter.hdr_sess("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"), "sure_sid=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"), true)),
      Test.unit("hdr clear", Test.bool(String.includes(Sure.Tweeter.hdr_clear, "Max-Age=0"), true)),
      Test.io("tweeter register empty", IO {
        get o = Db.with<String>("suremem:tweeter-t1", (c) IO {
          get s = Sure.Tweeter.do_register(c, "", "x")
          return Outcome.ok<Db.Err, String>(s)
        })
        return case o {
          err: Test.Result.fail("db")
          ok: Test.string(o.value, "err empty_user")
        }
      }),
      Test.io("tweeter login empty pass", IO {
        get o = Db.with<String>("suremem:tweeter-t2", (c) IO {
          get s = Sure.Tweeter.do_login(c, "ada", "")
          return Outcome.ok<Db.Err, String>(s)
        })
        return case o {
          err: Test.Result.fail("db")
          ok: Test.string(o.value, "err empty_pass")
        }
      }),
      Test.io("tweeter register login tweet", IO {
        get o = Db.with<String>("suremem:tweeter-t3", (c) IO {
          get r = Sure.Tweeter.do_register(c, "ada", "secret")
          get l = Sure.Tweeter.do_login(c, "ada", "secret")
          get bad = Sure.Tweeter.do_login(c, "ada", "nope")
          get taken = Sure.Tweeter.do_register(c, "ada", "secret")
          let sid = case Sure.Tweeter.read_sid(l) as s {
            none: ""
            some: s.value
          }
          get tw = Sure.Tweeter.do_tweet(c, sid, "hi", "")
          get fd = Sure.Tweeter.do_feed(c, sid)
          get ns = Sure.Tweeter.do_tweet(c, "", "hi", "")
          get up0 = Sure.Tweeter.do_upload(c, sid, "")
          get up = Sure.Tweeter.do_upload(c, sid, "data:image/png;base64,AA")
          get me = Sure.Tweeter.do_me(c, sid)
          get lo1 = Sure.Tweeter.do_logout(c, sid)
          get lo2 = Sure.Tweeter.do_logout(c, sid)
          return Outcome.ok<Db.Err, String>(r | "|" | bad | "|" | taken | "|" | tw | "|" | fd | "|" | ns | "|" | up0 | "|" | up | "|" | me | "|" | lo1 | "|" | lo2)
        })
        return case o {
          err: Test.Result.fail("db")
          ok:
            if Bool.not(String.starts_with(o.value, "ok ")) then Test.Result.fail(o.value)
            else if Bool.not(String.includes(o.value, "err bad_pass")) then Test.Result.fail(o.value)
            else if Bool.not(String.includes(o.value, "err taken")) then Test.Result.fail(o.value)
            else if Bool.not(String.includes(o.value, "ok ada~hi~")) then Test.Result.fail(o.value)
            else if Bool.not(String.includes(o.value, "err no_session")) then Test.Result.fail(o.value)
            else if Bool.not(String.includes(o.value, "err empty_file")) then Test.Result.fail(o.value)
            else if Bool.not(String.includes(o.value, "ok ")) then Test.Result.fail(o.value)
            else if Bool.not(String.includes(o.value, " ada")) then Test.Result.fail(o.value)
            else if Bool.not(String.includes(o.value, "err no_session")) then Test.Result.fail(o.value)
            else Test.assert(true, "ok")
        }
      }),
    ]),
    Test.group("Sure.Check", [
      Test.unit("box e", Test.string(Sure.Check.Box.e_of(Sure.Check.Box.new("1", "2", "3", "4", "5")), "5")),
      Test.unit("box empty a", Test.string(Sure.Check.Box.a_of(Sure.Check.Box.new("", "2", "3", "4", "5")), "")),
      Test.unit("nat empty", Test.nat(Nat.read(""), 0)),
      Test.unit("nat junk", Test.nat(Nat.read("x"), 0)),
      Test.unit("nat day", Test.nat(Nat.read("86400000"), Nat.mul(Nat.read("86400"), Nat.read("1000")))),
      Test.unit("nat div0", Test.nat(Nat.div(Nat.read("86400000"), 0), 0)),
      Test.unit("nat lte", Test.bool(Nat.lte(3, 5), true)),
      Test.unit("map miss", Test.bool(Maybe.is_none<Nat>(Map.get<Nat>("z", Map.from_list<Nat>([]))), true)),
      Test.unit("map get",
        case Map.get<Nat>("a", Map.set<Nat>("a", 1, Map.from_list<Nat>([]))) as m {
          none: Test.Result.fail("none")
          some: Test.nat(m.value, 1)
        }),
      Test.unit("json one", Test.string(JSON.field_string(JSON.object(Map.from_list<JSON>([{"k", JSON.string("v")}])), "k"), "v")),
    ]),
    Test.group("Date", [
      Test.unit("leap 0", Test.bool(Date.is_leap(0), true)),
      Test.unit("leap 1", Test.bool(Date.is_leap(1), false)),
      Test.unit("leap 4", Test.bool(Date.is_leap(4), true)),
      Test.unit("leap 100", Test.bool(Date.is_leap(100), false)),
      Test.unit("leap 400", Test.bool(Date.is_leap(400), true)),
    ]),
