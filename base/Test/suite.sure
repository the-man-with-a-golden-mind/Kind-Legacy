      Test.unit("read empty", Test.bool(Maybe.is_none<Http.Method>(Http.Method.read("")), true)),
      Test.unit("read space", Test.bool(Maybe.is_none<Http.Method>(Http.Method.read("GET ")), true)),
      Test.unit("eql diff", Test.bool(Http.Method.eql(Http.Method.get, Http.Method.post), false)),
      Test.unit("eql self", Test.bool(Http.Method.eql(Http.Method.get, Http.Method.get), true)),
    ]),
