// Returns the process-local state stored at `key`.
// Missing keys come back as none. The host encodes none as an empty string.
IO.get_state(key: String): IO<Maybe<String>>
  IO.ask<Maybe<String>>("get_state", key, (val)
    case IO.tagged.read(val) as tag {
      err: IO.end<Maybe<String>>(none)
      ok:
        if String.is_empty(tag.value) then
          IO.end<Maybe<String>>(none)
        else
          IO.end<Maybe<String>>(some(tag.value))
    })
