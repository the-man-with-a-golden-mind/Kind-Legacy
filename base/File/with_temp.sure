File.with_temp.go<A: Type>(path: Path, use: Path -> IO<A>): IO<A>
  IO.bracket<A, Path>(
    IO {
      get _ = Host.perform(Host.Op.fs_temp_push(Path.text(path)))
      return path
    },
    use,
    (p) IO {
      get _ = Host.perform(Host.Op.fs_temp_pop(Path.text(p)))
      return Unit.new
    }
  )

File.with_temp<A: Type>(use: Path -> IO<A>): IO<A>
  IO {
    get t = IO.get_time
    let path = Path.unsafe(".cache/kind_tmp_" | Nat.show(t) | ".txt")
    File.with_temp.go<A>(path, use)
  }
