String.hex.decode.go(hexs: String): String
  case hexs {
    nil:
      ""
    cons: 
      let init = String.take(4, hexs)
      let rest = String.drop(4, hexs)
      let numb = Parser.run!(Parser.hex_nat, "0x" | init) <> 0
      let char = Nat.to_u16(numb)
      if String.eql(init, "0000") then
        ""
      else
        Char.to_string(char) | String.hex.decode.go(rest)
  }

String.hex.decode(hexs: String): String
  String.hex.decode.go(hexs)

String.hex.decode.ascii.go(hexs: String): String
  case hexs {
    nil:
      ""
    cons: 
      let init = String.take(2, hexs)
      let rest = String.drop(2, hexs)
      let numb = Parser.run!(Parser.hex_nat, "0x" | init) <> 0
      let char = Nat.to_u16(numb)
      if String.eql(init, "00") then
        ""
      else
        Char.to_string(char) | String.hex.decode.ascii.go(rest)
  }

String.hex.decode.ascii(hexs: String): String
  String.hex.decode.ascii.go(hexs)

String.hex.encode.char_to_hex16(chr: Char): String
  String.pad_left(4, '0', U16.show_hex(chr))

String.hex.encode.go(str: String, result: String): String
  case str {
    nil: result
    cons: String.hex.encode.go(str.tail, result | String.hex.encode.char_to_hex16(str.head))
  }

String.hex.encode(str: String): String
  String.hex.encode.go(str, "")

String.hex.encode.ascii.char_to_hex8(chr: Char): String
  String.pad_left(2, '0', U16.show_hex(chr))

String.hex.encode.ascii.go(str: String, result: String): String
  case str {
    nil: result
    cons: String.hex.encode.ascii.go(str.tail, result | String.hex.encode.ascii.char_to_hex8(str.head))
  }

String.hex.encode.ascii(str: String): String
  String.hex.encode.ascii.go(str, "")

String.hex.encode.utf8(str: String): String
  case str {
    nil: String.nil
    cons:
      let hex = U16.to_hex.show(str.head)
      String.concat(hex, String.hex.encode.utf8(str.tail))
  }

String.hex.read_u8(s: String): Maybe<Pair<Nat, String>>
  let pair = String.take(2, s)
  if Nat.eql(String.length(pair), 2) then
    case Parse.hex(pair) as hx {
      none: Maybe.none!
      some: Maybe.some!({hx.value, String.drop(2, s)})
    }
  else Maybe.none!

String.hex.utf8.cont(b: Nat): Bool
  Bool.and(Nat.gte(b, 128), Nat.ltn(b, 192))

String.hex.utf8.bmp(cp: Nat): String
  Char.to_string(Nat.to_u16(cp))

String.hex.utf8.astral(cp: Nat): String
  let u = Nat.sub(cp, 0x10000)
  let hi = Nat.add(0xD800, Nat.div(u, 0x400))
  let lo = Nat.add(0xDC00, Nat.mod(u, 0x400))
  Char.to_string(Nat.to_u16(hi)) | Char.to_string(Nat.to_u16(lo))

String.hex.decode.utf8(b: String): String
  String.hex.decode.utf8.go(b)

String.hex.decode.utf8.step(b: String): Maybe<Pair<String, String>>
  case String.hex.read_u8(b) as u0 {
    none: Maybe.none!
    some:
      let p0 = u0.value
      open p0
      let b0 = p0.fst
      let rest = p0.snd
      if Nat.ltn(b0, 128) then
        Maybe.some!({String.hex.utf8.bmp(b0), rest})
      else if Nat.ltn(b0, 194) then
        Maybe.none!
      else if Nat.ltn(b0, 224) then
        case String.hex.read_u8(rest) as u1 {
          none: Maybe.none!
          some:
            let p1 = u1.value
            open p1
            let b1 = p1.fst
            if String.hex.utf8.cont(b1) then
              let cp = Nat.add(Nat.mul(Nat.mod(b0, 32), 64), Nat.mod(b1, 64))
              Maybe.some!({String.hex.utf8.bmp(cp), p1.snd})
            else Maybe.none!
        }
      else if Nat.ltn(b0, 240) then
        case String.hex.read_u8(rest) as u1 {
          none: Maybe.none!
          some:
            let p1 = u1.value
            open p1
            let b1 = p1.fst
            case String.hex.read_u8(p1.snd) as u2 {
              none: Maybe.none!
              some:
                let p2 = u2.value
                open p2
                let b2 = p2.fst
                if Bool.and(String.hex.utf8.cont(b1), String.hex.utf8.cont(b2)) then
                  let cp = Nat.add(
                    Nat.add(Nat.mul(Nat.mod(b0, 16), 4096), Nat.mul(Nat.mod(b1, 64), 64)),
                    Nat.mod(b2, 64))
                  if Bool.and(Nat.gte(cp, 0x800), Bool.or(Nat.ltn(cp, 0xD800), Nat.gtn(cp, 0xDFFF))) then
                    Maybe.some!({String.hex.utf8.bmp(cp), p2.snd})
                  else Maybe.none!
                else Maybe.none!
            }
        }
      else if Nat.ltn(b0, 245) then
        case String.hex.read_u8(rest) as u1 {
          none: Maybe.none!
          some:
            let p1 = u1.value
            open p1
            let b1 = p1.fst
            case String.hex.read_u8(p1.snd) as u2 {
              none: Maybe.none!
              some:
                let p2 = u2.value
                open p2
                let b2 = p2.fst
                case String.hex.read_u8(p2.snd) as u3 {
                  none: Maybe.none!
                  some:
                    let p3 = u3.value
                    open p3
                    let b3 = p3.fst
                    if Bool.and(
                      String.hex.utf8.cont(b1),
                      Bool.and(String.hex.utf8.cont(b2), String.hex.utf8.cont(b3))) then
                      let cp = Nat.add(
                        Nat.add(
                          Nat.mul(Nat.mod(b0, 8), 262144),
                          Nat.mul(Nat.mod(b1, 64), 4096)),
                        Nat.add(Nat.mul(Nat.mod(b2, 64), 64), Nat.mod(b3, 64)))
                      if Bool.and(Nat.gte(cp, 0x10000), Nat.lte(cp, 0x10FFFF)) then
                        Maybe.some!({String.hex.utf8.astral(cp), p3.snd})
                      else Maybe.none!
                    else Maybe.none!
                }
            }
        }
      else Maybe.none!
  }

String.hex.decode.utf8.go(b: String): String
  case String.hex.decode.utf8.step(b) as step {
    none: ""
    some:
      let p = step.value
      open p
      p.fst | String.hex.decode.utf8.go(p.snd)
  }

