// The Kind prover is the type checker.
// A theorem is a well-typed term whose type is the proposition.
// This library is the small trusted surface for collecting those proofs.

Prove.refl<A: Type, x: A>: x == x
  refl

Prove.sym<A: Type, a: A, b: A>(e: a == b): b == a
  Equal.mirror<A, a, b>(e)

Prove.trans<A: Type, a: A, b: A, c: A>(d: a == b, e: b == c): a == c
  Equal.chain<A, a, b, c>(d, e)

Prove.cong<A: Type, B: Type, a: A, b: A>(f: A -> B, e: a == b): f(a) == f(b)
  Equal.apply<A, B, a, b, f>(e)

// A boolean that reduces to true is a theorem via refl.
Prove.holds(b: true == true): Unit
  unit
