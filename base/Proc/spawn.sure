Proc.spawn(file: String, args: List<String>): IO<Outcome<Proc.Err, Nat>>
  IO {
    get e = Host.perform(Host.Op.proc_spawn_ex(file, Proc.join_args(args), "", ""))
    return case e {
      err: Outcome.err<Proc.Err, Nat>(Proc.Err.io(Host.Err.show(e.error)))
      ok_unit: Outcome.err<Proc.Err, Nat>(Proc.Err.io("empty"))
      ok_string: Outcome.ok<Proc.Err, Nat>(Nat.read(e.value))
    }
  }
