  refl

Cover.time.dur_add_0: Time.Duration.eql(Time.Duration.add(Time.Duration.zero, Time.Duration.zero), Time.Duration.zero) == true
  refl

Cover.time.dur_ltn_0: Time.Duration.ltn(Time.Duration.zero, Time.Duration.zero) == false
  refl

Cover.time.stamp_eql_0: Time.Stamp.eql(Time.Stamp.new(0), Time.Stamp.new(0)) == true
