// Empty / junk / border lemmas for public API that Test.suite did not name.

Cover.file.bad_string: File.bad_string(Path.Err.empty) == Outcome.err<File.Err, String>(File.Err.bad_path(Path.Err.empty))
  refl

Cover.file.bad_unit: File.bad_unit(Path.Err.empty) == Outcome.err<File.Err, Unit>(File.Err.bad_path(Path.Err.empty))
  refl

Cover.file.bad_nul: File.bad_string(Path.Err.nul) == Outcome.err<File.Err, String>(File.Err.bad_path(Path.Err.nul))
  refl

Cover.file.bad_dotdot: File.bad_unit(Path.Err.dotdot) == Outcome.err<File.Err, Unit>(File.Err.bad_path(Path.Err.dotdot))
  refl

Cover.list.and_nil: List.and([]) == true
  refl

Cover.list.or_nil: List.or([]) == false
  refl

Cover.list.sum_nil: List.sum([]) == 0
  refl

Cover.list.product_nil: List.product([]) == 0
  refl

Cover.list.range_0: List.range(0) == []
  refl

Cover.list.seq_0: List.seq(0) == []
  refl

Cover.list.quicksort_nil: List.quicksort([]) == []
  refl

Cover.maybe.show_none: Maybe.show<Nat>(Nat.show, none) == "none()"
  refl

Cover.unit.show: Unit.show(unit) == "Unit.new"
  refl

Cover.queue.max_diff: Queue.max_diff == 2
  refl

Cover.set.has_empty: Set.has("", Set.new) == false
  refl

Cover.set.has_miss: Set.has("x", Set.new) == false
  refl

Cover.email.has_at_empty: Email.has_at("") == false
  refl

Cover.email.has_at_no: Email.has_at("ada") == false
  refl

Cover.email.has_at_yes: Email.has_at("a@b") == true
  refl

Cover.email.show: Email.show(Email.new("a@b")) == "a@b"
  refl

Cover.json.enc_unit: JSON.enc.unit == JSON.null
  refl

Cover.json.enc_string_empty: JSON.enc.string("") == JSON.string("")
  refl

Cover.bytes.empty: Bytes.empty == []
  refl

Cover.bytes.from_nat_0: Bytes.from_nat(0) == []
  refl

Cover.bytes.split_empty: Bytes.split([], 0) == Pair.new<Bytes, Bytes>([], [])
  refl

Cover.bool.eql_tt: Bool.eql(true, true) == true
  refl

Cover.bool.eql_tf: Bool.eql(true, false) == false
  refl

Cover.bool.eql_ff: Bool.eql(false, false) == true
  refl

Cover.bool.xor_ff: Bool.xor(false, false) == false
  refl

Cover.bool.xor_tf: Bool.xor(true, false) == true
  refl

Cover.bool.is_true: Bool.is_true(true) == true
  refl

Cover.bool.is_false: Bool.is_false(false) == true
  refl

Cover.cmp.eql: Cmp.as_eql(Cmp.eql) == true
  refl

Cover.cmp.ltn: Cmp.as_eql(Cmp.ltn) == false
  refl

Cover.cmp.as_ltn: Cmp.as_ltn(Cmp.ltn) == true
  refl

Cover.cmp.as_gtn: Cmp.as_gtn(Cmp.gtn) == true
  refl

Cover.cmp.as_lte: Cmp.as_lte(Cmp.eql) == true
  refl

Cover.cmp.as_gte: Cmp.as_gte(Cmp.eql) == true
  refl

Cover.string.length_empty: String.length("") == 0
  refl

Cover.string.not_empty_no: String.not_empty("") == false
  refl

Cover.string.not_empty_yes: String.not_empty("a") == true
  refl

Cover.string.head_empty: Maybe.is_none<Char>(String.head("")) == true
  refl

Cover.string.repeat_0: String.repeat("a", 0) == ""
  refl

Cover.string.reverse_empty: String.reverse("") == ""
  refl

Cover.string.is_ascii_empty: String.is_ascii("") == true
  refl

Cover.string.is_hex_empty: String.is_hex("") == true
  refl

Cover.string.is_lower_empty: String.is_lower("") == true
  refl

Cover.string.is_upper_empty: String.is_upper("") == true
  refl

Cover.string.concat_empty: String.concat("", "") == ""
  refl

Cover.string.append_empty: String.append("", 'x') == "x"
  refl

Cover.string.join_nil: String.join(",", []) == ""
  refl

Cover.string.split_empty: List.length<String>(String.split("", ",")) == 1
  refl

Cover.string.ends_with_empty: String.ends_with("", "") == true
  refl

Cover.string.to_list_empty: String.to_list("") == []
  refl

Cover.string.to_lower_empty: String.to_lower("") == ""
  refl

Cover.string.to_upper_empty: String.to_upper("") == ""
  refl

Cover.string.trim_empty: String.trim("") == ""
  refl

Cover.string.trim_right_empty: String.trim_right("") == ""
  refl

Cover.string.filter_empty: String.filter(Char.is_space, "") == ""
  refl

Cover.string.map_empty: String.map(Char.to_upper, "") == ""
  refl

Cover.string.drop_while_empty: String.drop_while(Char.is_space, "") == ""
  refl

Cover.string.take_while_empty: String.take_while(Char.is_space, "") == ""
  refl

Cover.string.pad_left_0: String.pad_left(0, ' ', "x") == "x"
  refl

Cover.nat.is_zero_0: Nat.is_zero(0) == true
  refl

Cover.nat.is_zero_1: Nat.is_zero(1) == false
  refl

Cover.nat.is_even_0: Nat.is_even(0) == true
  refl

Cover.nat.odd_0: Nat.odd(0) == false
  refl

Cover.nat.gtn_00: Nat.gtn(0, 0) == false
  refl

Cover.nat.min_00: Nat.min(0, 0) == 0
  refl

Cover.nat.square_0: Nat.square(0) == 0
  refl

Cover.nat.to_string_0: Nat.to_string(0) == "z"
  refl

Cover.nat.to_string_base_10: Nat.to_string_base(10, 0) == "0"
  refl

Cover.nat.same_0: Nat.same(0) == 0
  refl

Cover.nat.between_001: Nat.between(0, 0, 1) == true
  refl

Cover.nat.pred_0: Nat.pred(0) == 0
  refl

Cover.nat.bitlen_0: Nat.bitlen(0) == 0
  refl

Cover.regex.match_eps_empty: Regex.match(Regex.eps, "") == true
  refl

Cover.regex.match_never: Regex.match(Regex.never, "") == false
  refl

Cover.regex.contains_never: Regex.contains(Regex.never, "") == false
  refl

Cover.regex.in_class_empty: Regex.in_class("", 'a') == false
  refl

Cover.regex.flat_nil: Regex.flat([], (s) [s]) == []
  refl

Cover.regex.shorter: Regex.shorter("ab", "a") == true
  refl

