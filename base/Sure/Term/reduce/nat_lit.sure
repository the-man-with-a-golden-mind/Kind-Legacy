Sure.Term.reduce.nat_lit(term: Sure.Term): Maybe<Nat>
  case term {
    nat: some(term.natx)
    ref:
      if String.eql(term.name, "Nat.zero") then some(0) else none
    ori: Sure.Term.reduce.nat_lit(term.expr)
    imp: Sure.Term.reduce.nat_lit(term.expr)
    ann: Sure.Term.reduce.nat_lit(term.term)
    app:
      case term.func {
        ref:
          if String.eql(term.func.name, "Nat.succ") then
            case Sure.Term.reduce.nat_lit(term.argm) as n {
              none: none
              some: some(Nat.succ(n.value))
            }
          else none
        ori: Sure.Term.reduce.nat_lit(Sure.Term.app(term.func.expr, term.argm))
        imp: Sure.Term.reduce.nat_lit(Sure.Term.app(term.func.expr, term.argm))
        ann: Sure.Term.reduce.nat_lit(Sure.Term.app(term.func.term, term.argm))
        _: none
      }
  } default none
