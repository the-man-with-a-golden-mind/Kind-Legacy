// Check a source buffer with a real IO runner (loads local deps).
// Prefer this over Sure.api.check_code, which uses IO.purify.
Sure.api.io.check_code(code: String): IO<String>
  case Sure.Defs.read("Main.sure", code, Sure.Map.new!) as read {
    left:
      IO {
        return read.value
      }
    right: IO {
      let defs = read.value
      let nams = List.mapped!(BitsMap.keys!(defs))!(Sure.Name.from_bits)
      get defs = Sure.Synth.many(nams, defs)
      return Sure.Defs.report(defs, nams)
    }
  }

