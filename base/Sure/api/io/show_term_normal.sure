// TODO: remove duplicate code on Kind/api/io/check_term.sure
Sure.api.io.show_term_normal(name: String): IO<Unit>
  IO {
    get new_defs = Sure.Synth.one(name, Sure.Map.new!)
    IO.print(case new_defs {
      none:
        let notfound = "Term not found: '" | name | "'."
        let filelist = List.mapped!(Sure.Synth.files_of(name))!((x) "'" | x | "'")
        let searched = "Searched on: " | String.join(", ",filelist) | "."
        notfound | "\n" | searched
      some:
        let defs = new_defs.value
        let defn = Sure.Map.get!(name, defs)
        without defn: "Term not found: '" | name | "'."
        open defn
        let term = defn.term
        let norm = Sure.Term.normalize(term, defs)
        Sure.Term.show(norm)
    })
  }
