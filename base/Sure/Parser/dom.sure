// for..in of dom 
Sure.Parser.dom.for: Parser<Sure.Term>
  Sure.Parser.block("for_dom", Parser {
    // read variable
    Sure.Parser.text("for ")
    get elem = Sure.Parser.name1

    // read list
    Sure.Parser.text("in")
    get list = Sure.Parser.term
    
    // read return 
    Sure.Parser.text(":")
    get loop = Sure.Parser.term

    // put all elements inside one list [] 
    let term = Sure.Term.ref("List.fold")
    let term = Sure.Term.app(term, Sure.Term.hol(Bits.e))
    let term = Sure.Term.app(term, list)
    let term = Sure.Term.app(term, Sure.Term.hol(Bits.e))
    let term = Sure.Term.app(term, Sure.Parser.dom.empty_list)
    let lamb = Sure.Term.lam(elem, (i) Sure.Term.lam("placeholder", (b) Sure.Term.app(Sure.Term.app(Sure.Parser.dom.list_cons, loop), b)))
    let term = Sure.Term.app(term, lamb)
    
    // let root = Sure.Parser.dom.for.wrapper(term)
    return term
  })

// for..in map of dom
Sure.Parser.dom.formap: Parser<Sure.Term>
  Sure.Parser.block("formap_dom", Parser {
    // read variable
    Sure.Parser.text("for ")
    get key  = Sure.Parser.name1
    Sure.Parser.text(":")
    get value = Sure.Parser.name1

    // read list
    Sure.Parser.text("in")
    get map = Sure.Parser.term
    
    // read return 
    Sure.Parser.text(":")
    get loop = Sure.Parser.term

    // put all elements inside one list [] 
    let term = Sure.Term.ref("BBT.for")
    let term = Sure.Term.app(term, Sure.Term.hol(Bits.e))
    let term = Sure.Term.app(term, Sure.Term.hol(Bits.e))
    let term = Sure.Term.app(term, map)
    let term = Sure.Term.app(term, Sure.Term.hol(Bits.e))
    let term = Sure.Term.app(term, Sure.Parser.dom.empty_list)
    let lamb = Sure.Term.lam(key, (k) Sure.Term.lam(value, (v) Sure.Term.lam("placeholder", (z) Sure.Term.app(Sure.Term.app(Sure.Parser.dom.list_cons, loop), z))))
    let term = Sure.Term.app(term, lamb)
    
    // let root = Sure.Parser.dom.for.wrapper(term)
    return term
  })

// transform list of Sure.Term in a Sure.Term representing a list
Sure.Parser.dom.transform_children(a: List<Either<Sure.Term, Sure.Term>>): Sure.Term
  case a {
    nil: 
      Sure.Term.app(Sure.Term.ref("List.nil"), Sure.Term.hol(Bits.e))
    cons:
      case a.head {
        left:
          let term = Sure.Term.app(Sure.Term.ref("List.cons"), Sure.Term.hol(Bits.e))
          let term = Sure.Term.app(term, a.head.value)
          let term = Sure.Term.app(term, Sure.Parser.dom.transform_children(a.tail))
          term
        right:
          let term = Sure.Term.app(Sure.Term.ref("List.concat"), Sure.Term.hol(Bits.e))
          let term = Sure.Term.app(term, a.head.value)
          let term = Sure.Term.app(term, Sure.Parser.dom.transform_children(a.tail))
          term
      }
  }

// parser of a node leaf
// can be a dynamic DOM or a text
Sure.Parser.dom.leaf: Parser<Either<Sure.Term, Sure.Term>>
  Parser.block!("DOM_leaf", Parser {
    get term = Parser.choice!([
      Sure.Parser.dom.for,
      Sure.Parser.dom.formap,
      Sure.Parser.dom.dynamic,
      Sure.Parser.dom.text
    ])

    return Either.right<Sure.Term, Sure.Term>(term)
  })

// parser of a dynamic DOM
// the dynamic DOM must be inside {  }
// the dynamic DOM can be:
// - any kind term that returns a DOM
Sure.Parser.dom.dynamic: Parser<Sure.Term>
  Sure.Parser.block("DOM_dynamic", Parser {
    Sure.Parser.text("{")
    get item = Parser.choice!([
      Sure.Parser.term
    ])
    Sure.Parser.text("}")
    
    let term = Sure.Term.ref("List.cons")
    let term = Sure.Term.app(term, Sure.Term.hol(Bits.e))
    let term = Sure.Term.app(term, item)
    let term = Sure.Term.app(term, Sure.Parser.dom.empty_list)
    return term
  })

// parsers dom text
// it is the leaf
Sure.Parser.dom.text: Parser<Sure.Term>
  Sure.Parser.block("DOM_text", Parser {
    let term = Sure.Term.ref("DOM.text")
    get expr = Sure.Parser.term
    let item = Sure.Term.app(term, expr)
    
    let term = Sure.Term.ref("List.cons")
    let term = Sure.Term.app(term, Sure.Term.hol(Bits.e))
    let term = Sure.Term.app(term, item)
    let term = Sure.Term.app(term, Sure.Parser.dom.empty_list)
    return term
  })

// parses nothing
Sure.Parser.dom.none: Parser(DOM)
  Parser {
    Sure.Parser.text("")
    return DOM.text("")
  }

// prop type
Sure.Parser.dom.Prop: Type
  Pair<String, Sure.Term>

// parser one prop
Sure.Parser.dom.prop: Parser<Sure.Parser.dom.Prop>
  Parser {
    get prop  = Sure.Parser.name1
    let prop  = Sure.Parser.dom.prop.camel_to_kebab(prop)
    Sure.Parser.text("=")
    get value = Sure.Parser.term
    Sure.Parser.spaces
    return Pair.new!!(prop, value)
  }

Sure.Parser.dom.prop.camel_to_kebab(str: String): String
  String.reverse(Sure.Parser.dom.prop.camel_to_kebab.go(str, ""))

Sure.Parser.dom.prop.camel_to_kebab.go(str: String, result: String): String
  case str {
    nil: result
    cons: 
      if Char.is_upper(str.head) then
        Sure.Parser.dom.prop.camel_to_kebab.go(str.tail, String.cons(Char.to_lower(str.head), String.cons('-', result)))
      else
        Sure.Parser.dom.prop.camel_to_kebab.go(str.tail, String.cons(str.head, result))
  }

