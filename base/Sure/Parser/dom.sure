Sure.Parser.dom: Parser<Sure.Term>
  Parser {
    get term = Parser.choice!([
      Sure.Parser.dom.fragment
      Sure.Parser.dom.node,
    ])
    case term {
      left: Parser { return term.value }
      right:
        let resu = Sure.Term.ref("DOM.node")
        let resu = Sure.Term.app(resu, Sure.Term.str("div"))
        let resu = Sure.Term.app(resu, Sure.Parser.dom.empty_map)
        let resu = Sure.Term.app(resu, Sure.Parser.dom.empty_map)
        let resu = Sure.Term.app(resu, term.value)
        Parser { return resu }
    }
  }

Sure.Parser.dom.fragment: Parser<Either<Sure.Term, Sure.Term>>
  let tag_name = "fragment"
  Parser.block!("DOM.fragment", Parser {
    Sure.Parser.text("<")
    Sure.Parser.text(tag_name)
    Sure.Parser.text(">")

    get children = Parser.many!(Parser.choice!([
      Sure.Parser.dom.fragment,
      Sure.Parser.dom.node,
      Sure.Parser.dom.leaf,
    ]))
    let children = Sure.Parser.dom.transform_children(children)

    Sure.Parser.text("</"| tag_name |">")
    let term = Sure.Term.ref("DOM.fragment")
    let term = Sure.Term.app(term, children)

    return Either.left!!(term)
  })

// main parser
Sure.Parser.dom.node: Parser<Either<Sure.Term, Sure.Term>>
  Parser.block!("DOM.node", Parser {
    Sure.Parser.text("<")

    // name of tag
    get tag = Sure.Parser.name1
    Sure.Parser.spaces

    // props and style
    get props = Parser.until!(Sure.Parser.text(">"), Sure.Parser.dom.prop)
    let props = Sure.Parser.dom.gen_prop(props)

    // children
    get children = Parser.many!(Parser.choice!([
      Sure.Parser.dom.fragment,
      Sure.Parser.dom.node,
      Sure.Parser.dom.leaf,
    ]))
    let children = Sure.Parser.dom.transform_children(children)

    // end of tag
    Sure.Parser.text("</"| tag |">")
    
    // creation of dom 
    let term = Sure.Term.ref("DOM.node")
    let term = Sure.Term.app(term, Sure.Term.str(tag))
    let term = Sure.Term.app(term, props@fst)
    let term = Sure.Term.app(term, props@snd)
    let term = Sure.Term.app(term, children)

    return Either.left!!(term)
  })

// helpers for dom's for's
Sure.Parser.dom.empty_list: Sure.Term 
  Sure.Term.app(Sure.Term.ref("List.nil"), Sure.Term.hol(Bits.e))

Sure.Parser.dom.list_cons: Sure.Term
  Sure.Term.app(Sure.Term.ref("List.cons"), Sure.Term.hol(Bits.e))

Sure.Parser.dom.empty_map: Sure.Term 
  Sure.Term.app(Sure.Term.ref("Map.new"),  Sure.Term.hol(Bits.e))

