// get list of props and parses into a pair
// first pos of pair will be a Sure.Term of a map of props
// second pos of pair will be a Sure.Term of a map of styles
Sure.Parser.dom.gen_prop.go(values: List<Sure.Parser.dom.Prop>, result: Pair<Sure.Term, Sure.Term>): Pair<Sure.Term, Sure.Term>
  case values {
    nil: result
    cons: 
      let {name, value} = values.head

      if String.eql(name, "style") then 
        Sure.Parser.dom.gen_prop.go(values.tail, {result@fst, value})
      else 
        let pair = Sure.Term.ref("Pair.new")
        let pair = Sure.Term.app(pair, Sure.Term.hol(Bits.e))
        let pair = Sure.Term.app(pair, Sure.Term.hol(Bits.e))
        let pair = Sure.Term.app(pair, Sure.Term.str(name))
        let pair = Sure.Term.app(pair, value)
        let term = Sure.Term.ref("List.cons")
        let term = Sure.Term.app(term, Sure.Term.hol(Bits.e))
        let term = Sure.Term.app(term, pair)
        let term = Sure.Term.app(term, result@fst)
        Sure.Parser.dom.gen_prop.go(values.tail, {term, result@snd})
  }
