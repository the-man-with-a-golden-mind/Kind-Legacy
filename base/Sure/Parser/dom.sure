// get list of props and parses into a pair
// first pos of pair will be a Sure.Term of a map of props
// second pos of pair will be a Sure.Term of a map of styles
Sure.Parser.dom.gen_prop(values: List<Sure.Parser.dom.Prop>): Pair<Sure.Term, Sure.Term>
  let {list_prop, styles} = Sure.Parser.dom.gen_prop.go(values, {Sure.Parser.dom.empty_list, Sure.Parser.dom.empty_map})

  let term_prop = Sure.Term.ref("Map.from_list")
  let term_prop = Sure.Term.app(term_prop, Sure.Term.hol(Bits.e))
  let term_prop = Sure.Term.app(term_prop, list_prop)
  {term_prop, styles}

