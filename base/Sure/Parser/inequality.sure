Sure.Parser.inequality(val0: Sure.Term): Parser(Sure.Term)
  Parser {
    Sure.Parser.text("!=")
    get val1 = Sure.Parser.term
    let term = Sure.Term.ref("Equal")
    let term = Sure.Term.app(term, Sure.Term.hol(Bits.e))
    let term = Sure.Term.app(term, val0)
    let term = Sure.Term.app(term, val1)
    let term = Sure.Term.app(Sure.Term.ref("Not"), term)
    return term
  }
