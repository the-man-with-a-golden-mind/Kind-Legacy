Sure.Parser.block(name: String, parse: Parser<Sure.Term>): Parser<Sure.Term>
  (pst)
  open pst
  let reply = Sure.Parser.spaces(pst)
  case reply {
    error: 
      Parser.Reply.error!(reply.err)
    value:
      let pst = reply.pst
      open pst
      let reply = parse(Parser.State.new(pst.err, name, pst.idx, pst.idx, pst.str))
      case reply {
        error:
          Parser.Reply.error!(reply.err)
        value: 
          open reply.pst
          let new_pst = Parser.State.new(reply.pst.err, pst.nam, pst.ini, reply.pst.idx, reply.pst.str)
          Parser.Reply.value!(new_pst, Sure.Term.ori({pst.idx,reply.pst.idx}, reply.val))
      }
  }
