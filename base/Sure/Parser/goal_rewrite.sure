Sure.Parser.goal_rewrite: Parser(Sure.Term)
  Sure.Parser.block("goal-rewrite", Parser {
    Sure.Parser.text("rewrite ")
    get name = Sure.Parser.name1
    Sure.Parser.text("in")
    get type = Sure.Parser.term
    Sure.Parser.text("with")
    get iseq = Sure.Parser.term
    get body = Sure.Parser.term
    let moti = Sure.Term.lam(name, (s) Sure.Term.lam("", (x) type))
    let term = Sure.Term.ref("Equal.mirror")
    let term = Sure.Term.app(term, Sure.Term.hol(Bits.e)) 
    let term = Sure.Term.app(term, Sure.Term.hol(Bits.e))
    let term = Sure.Term.app(term, Sure.Term.hol(Bits.e))
    let term = Sure.Term.app(term, iseq)
    let term = Sure.Term.app(term, moti)
    let term = Sure.Term.app(term, body)
    return term
  })


