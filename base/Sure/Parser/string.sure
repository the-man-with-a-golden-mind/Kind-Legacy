Sure.Parser.string.go(delim: Char, str: String): Parser<String>
  (pst)
  open pst
  case pst.str {
    nil:
      Parser.Reply.fail<String>(pst.nam, pst.ini, pst.idx, "Non-terminating string.")
    cons:
      if U16.eql(pst.str.head, delim) then
        let pst = Parser.State.new(pst.err, pst.nam, pst.ini, Nat.succ(pst.idx), pst.str.tail)
        Parser.Reply.value<String>(pst, String.reverse(str))
      else case Sure.Parser.char.single(pst) as parsed {
        error: Parser.Reply.error<String>(parsed.err)
        value: Sure.Parser.string.go(delim, String.cons(parsed.val,str), parsed.pst)
      }
  }

Sure.Parser.string(delim: Char): Parser(Sure.Term)
  Sure.Parser.block("string", Parser {
    Sure.Parser.text(String.cons(delim, String.nil))
    get strx = Sure.Parser.string.go(delim, "")
    return Sure.Term.str(strx)
  })
