Sure.Parser.lambda: Parser(Sure.Term)
  Sure.Parser.block("term", Parser {
    Parser.choice!([
      Sure.Parser.lambda.1,
      Sure.Parser.lambda.2
    ])
  })

Sure.Parser.lambda.1: Parser(Sure.Term)
  Sure.Parser.block("lambda", Parser {
    get nams = Sure.Parser.items!("(", Sure.Parser.name1, ")")
    get body = Parser.avoiding!(Sure.Parser.text_now("("), Sure.Parser.term)
    return Sure.Parser.lambda.make.start(nams, body)
  })

Sure.Parser.lambda.erased: Parser(Sure.Term)
  Sure.Parser.block("lambda", Parser {
    get nams = Sure.Parser.items!("<", Sure.Parser.name1, ">")
    get body = Sure.Parser.term
    return Sure.Parser.lambda.make.start(nams, body)
  })

