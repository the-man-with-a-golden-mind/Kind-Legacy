Sure.Parser.letforinmap(body: Unit -> Parser(Sure.Term)): Parser(Sure.Term)
  Sure.Parser.block("let-for-map", Parser {
    Sure.Parser.text("let ")
    get name = Sure.Parser.name1
    Sure.Parser.text("=")
    Sure.Parser.text("for ")
    get key = Sure.Parser.name1
    Sure.Parser.text(":")
    get val = Sure.Parser.name1
    Sure.Parser.text("in")
    get map = Sure.Parser.term
    Sure.Parser.text(":")
    get loop = Sure.Parser.term
    Parser.maybe!(Sure.Parser.text(";"))
    get body = body(unit)
    let term = Sure.Term.ref("BBT.for")
    let term = Sure.Term.app(term, Sure.Term.hol(Bits.e))
    let term = Sure.Term.app(term, Sure.Term.hol(Bits.e))
    let term = Sure.Term.app(term, map)
    let term = Sure.Term.app(term, Sure.Term.hol(Bits.e))
    let term = Sure.Term.app(term, Sure.Term.ref(name))
    let lamb = Sure.Term.lam(key, (k) Sure.Term.lam(val, (i) Sure.Term.lam(name, (x) loop)))
    let term = Sure.Term.app(term, lamb)
    let term = Sure.Term.let(name, term, (x) body)
    return term
  })

Sure.Parser.letforinmap.with(body: Unit -> Parser(Sure.Term)): Parser(Sure.Term)
  Sure.Parser.block("for-map", Parser {
    Sure.Parser.text("for ")
    get key = Sure.Parser.name1
    Sure.Parser.text(":")
    get val = Sure.Parser.name1
    Sure.Parser.text("in")
    get map = Sure.Parser.term
    Sure.Parser.text("with")
    get name = Sure.Parser.name1
    Sure.Parser.text(":")
    get loop = Sure.Parser.term
    Parser.maybe!(Sure.Parser.text(";"))
    get body = body(unit)
    let term = Sure.Term.ref("BBT.for")
    let term = Sure.Term.app(term, Sure.Term.hol(Bits.e))
    let term = Sure.Term.app(term, Sure.Term.hol(Bits.e))
    let term = Sure.Term.app(term, map)
    let term = Sure.Term.app(term, Sure.Term.hol(Bits.e))
    let term = Sure.Term.app(term, Sure.Term.ref(name))
    let lamb = Sure.Term.lam(key, (k) Sure.Term.lam(val, (i) Sure.Term.lam(name, (x) loop)))
    let term = Sure.Term.app(term, lamb)
    let term = Sure.Term.let(name, term, (x) body)
    return term
  })
