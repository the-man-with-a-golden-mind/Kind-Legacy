Sure.Parser.without: Parser(Sure.Term)
  Sure.Parser.block("without", Parser {
    Sure.Parser.text("without ")
    get name = Sure.Parser.name1
    Sure.Parser.text(":")
    get dflt = Sure.Parser.term
    get rest = Sure.Parser.term
    let term = Sure.Term.ref(name)
    let term = Sure.Term.app(term, Sure.Term.lam("", (x) Sure.Term.hol(Bits.e)))
    let term = Sure.Term.app(term, dflt)
    let term = Sure.Term.app(term, Sure.Term.lam(name, (x) rest))
    return term
  })
