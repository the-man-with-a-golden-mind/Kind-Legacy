Sure.Defs.report(defs: Sure.Defs, names: List<Sure.Name>): String
  let types = Sure.Defs.report.types(defs, names)
  let errors = Sure.Defs.report.errors(defs)
  let errors = case errors {
    nil  : "All terms check."
    cons : errors
  }
  types | "\n" | errors
    
Sure.Defs.report.errors(defs: Sure.Defs): String
  let errors = ""
  let errors = for key in BitsMap.keys!(defs):
    let name = Sure.Name.from_bits(key)
    let defn = Sure.Map.get!(name, defs)
    without defn: errors
    open defn
    case defn.stat {
      fail: case defn.stat.errors {
        nil:
          errors
        cons:
          let name_str = defn.name
          let rel_errs = Sure.Error.relevant(defn.stat.errors)
          let errors = for err in rel_errs:
            let err_msg = Sure.Error.show(err, defs)
            let ori_val = Sure.Error.origin(err)
            without ori_val: errors | err_msg | "\n"
            open ori_val
            let source = Sure.Code.highlight(none, some(defn.file), defn.code, ori_val.fst, ori_val.fst, ori_val.snd)
            errors | err_msg | source | "\n" | "\n"
          errors
      }
    } default errors
  errors

Sure.Defs.report.types(defs: Sure.Defs, names: List<Sure.Name>): String
  let types = ""
  let types = for name in names:
    case Sure.Map.get!(name, defs) as got {
      none:
        types
      some:
        open got.value
        types | name | ": " | Sure.Term.show(got.value.type) | "\n"
    }
  types
