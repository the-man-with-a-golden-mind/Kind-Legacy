// Saves well-typed definitions on cache directory
Sure.Defs.cache(defs: Sure.Defs): IO(Unit)
  Sure.Defs.cache.go(Sure.Map.to_list!(defs))

Sure.Defs.cache.go(kvs: List(Pair(String,Sure.Def))): IO(Unit)
  case kvs {
    nil: IO {
      return unit
    }
    cons:
      let {name,defn} = kvs.head
      open defn
      case defn.stat {
        done: IO {
          Sure.Synth.load.cached.put(name, defn)
          Sure.Defs.cache.go(kvs.tail)
        }
      } default IO {
        Sure.Defs.cache.go(kvs.tail)
      }
  }

