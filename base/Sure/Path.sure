Sure.Path: Type
  Bits

Sure.Path.Builder: Type
  Bits -> Bits

Sure.Path.Maybe.Builder: Type
  Maybe<Sure.Path.Builder>

Sure.Path.patch_at.list<A: Type>(
  path: Sure.Path
  list: List<A>
  cont: Sure.Path -> A -> A
): List<A>
  case path {
    e: []
    o: case list {
      nil: []
      cons: cont(path.pred, list.head) & list.tail
    }
    i: case list {
      nil: []
      cons: list.head & Sure.Path.patch_at.list!(path.pred, list.tail, cont)
    }
  }

Sure.Path.patch_at.bitsmap<A: Type>(
  path: Sure.Path
  bmap: BitsMap<A>
  cont: Sure.Path -> A -> A
): BitsMap<A>
  case path {
    e: BitsMap.new!
    o: case bmap {
      new: BitsMap.new!
      tie: case bmap.val {
        none: BitsMap.tie!(none, bmap.lft, bmap.rgt)
        some: BitsMap.tie!(some(cont(path.pred, bmap.val.value)), bmap.lft, bmap.rgt)
      }
    }
    i: case path.pred {
      e: BitsMap.new!
      o: case bmap {
        new: BitsMap.new!
        tie: BitsMap.tie!(bmap.val, Sure.Path.patch_at.bitsmap<A>(path.pred.pred, bmap.lft, cont), bmap.rgt)
      }
      i: case bmap {
        new: BitsMap.new!
        tie: BitsMap.tie!(bmap.val, bmap.lft, Sure.Path.patch_at.bitsmap<A>(path.pred.pred, bmap.rgt, cont))
      }
    }
  }

Sure.Path.Builder.nat(n: Nat, b: Sure.Path.Builder): Sure.Path.Builder
  case n {
    zero: Sure.Path.Builder.o(b)
    succ: Sure.Path.Builder.i(Sure.Path.Builder.nat(n.pred, b))
  }

Sure.Path.Builder.bits(bits: Bits, b: Sure.Path.Builder): Sure.Path.Builder
  case bits {
    e: Sure.Path.Builder.o(b)
    o: Sure.Path.Builder.i(Sure.Path.Builder.o(Sure.Path.Builder.bits(bits.pred,b)))
    i: Sure.Path.Builder.i(Sure.Path.Builder.i(Sure.Path.Builder.bits(bits.pred,b)))
  }

Sure.Path.Builder.name(name: Sure.Name, b: Sure.Path.Builder): Sure.Path.Builder
  (x) Sure.Name.to_bits.go(name, b(x))

Sure.Path.Builder.i(path: Sure.Path.Builder): Sure.Path.Builder
  (x) path(Bits.i(x))

Sure.Path.Builder.o(path: Sure.Path.Builder): Sure.Path.Builder
  (x) path(Bits.o(x))

Sure.Path.Builder.nil: Sure.Path.Builder
  (x) x

Sure.Path.Builder.to_bits(path: Sure.Path.Builder): Bits
  path(Bits.e)

Sure.Path.Maybe.Builder.bits(bits: Bits, b: Sure.Path.Maybe.Builder): Sure.Path.Maybe.Builder
  case b {
    none: none
    some: some(Sure.Path.Builder.bits(bits, b.value))
  }

Sure.Path.Maybe.Builder.name(s: Sure.Name, b: Sure.Path.Maybe.Builder): Sure.Path.Maybe.Builder
  case b {
    none: none
    some: some(Sure.Path.Builder.name(s, b.value))
  }

Sure.Path.Maybe.Builder.i(path: Sure.Path.Maybe.Builder): Sure.Path.Maybe.Builder
  Maybe.mapped!(path)!(Sure.Path.Builder.i)

Sure.Path.Maybe.Builder.o(path: Sure.Path.Maybe.Builder): Sure.Path.Maybe.Builder
  Maybe.mapped!(path)!(Sure.Path.Builder.o)

Sure.Path.Maybe.Builder.nil: Sure.Path.Maybe.Builder
  Maybe.some!(Sure.Path.Builder.nil)

Sure.Path.Maybe.Builder.to_bits(path: Sure.Path.Maybe.Builder): Bits
  case path {
    none: Bits.e,
    some: path.value(Bits.e),
  }

