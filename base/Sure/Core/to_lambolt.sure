// Converts a Sure.Core term to Lambolt
Sure.Core.to_lambolt(defs: Sure.Core.Defs): String
  let def_list = List.map!!((p) p@snd, Map.to_list!(defs))
  let st = Sure.Core.to_lambolt.Builder.aux.new(2, "(Z) = 0\n(Typ) = 1")
  let ret = {st, ""}
  for def in def_list with ret:
    let {st, head} = ret
    let {st, tail} = Sure.Core.Def.to_lambolt(def, st, {})
    {st, head|tail}
  let {st, code} = ret
  let {n, ids} = st
  ids|code


Sure.Core.to_lambolt.lam_ref: Bool
  true

Sure.Core.to_lambolt.let_ref: Bool
  false

Sure.Core.to_lambolt.get_idx: Sure.Core.to_lambolt.Builder(Nat)
  (st, ids)
    open st
    {{st.n + 1, st.ids} :: Sure.Core.to_lambolt.Builder.aux, st.n}

Sure.Core.to_lambolt.to_defname(name: String): String
  "("|String.capitalize(name)|")"

Sure.Core.to_lambolt.add_defname(name: String): Sure.Core.to_lambolt.Builder(Unit)
  (st, ids)
    open st
    {
      {st.n + 1, st.ids|"\n"|Sure.Core.to_lambolt.to_defname(name)|" = "|Nat.show(st.n)}
        :: Sure.Core.to_lambolt.Builder.aux
      unit
    }

Sure.Core.to_lambolt.add_var<A: Type>(
  b: Sure.Core.to_lambolt.Builder(A)
  id: String
): Sure.Core.to_lambolt.Builder(A)
  (st, ids)
    b(st, ids{id} <- Sure.Core.to_lambolt.lam_ref)

Sure.Core.to_lambolt.add_let<A: Type>(
  b: Sure.Core.to_lambolt.Builder(A)
  id: String
): Sure.Core.to_lambolt.Builder(A)
  (st, ids)
    b(st, ids{id} <- Sure.Core.to_lambolt.let_ref)

Sure.Core.to_lambolt.test_ref(id: String): Sure.Core.to_lambolt.Builder(Maybe<Bool>)
  (st, ids)
    {st, ids{id}}

