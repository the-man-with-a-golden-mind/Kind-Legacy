type Sure.Core.to_lambolt.Builder.aux {
  new(
    n: Nat
    ids: String
  )
}

Sure.Core.to_lambolt.Builder(T: Type): Type
  Sure.Core.to_lambolt.Builder.aux -> Map<Bool> -> Pair<Sure.Core.to_lambolt.Builder.aux, T>

Sure.Core.to_lambolt.Builder.monad: Monad<Sure.Core.to_lambolt.Builder>
  Monad.new<Sure.Core.to_lambolt.Builder>(Sure.Core.to_lambolt.Builder.bind, Sure.Core.to_lambolt.Builder.pure)

Sure.Core.to_lambolt.Builder.bind<
  A: Type
  B: Type
>(
  here: Sure.Core.to_lambolt.Builder(A)
  next: A -> Sure.Core.to_lambolt.Builder(B)
): Sure.Core.to_lambolt.Builder(B)
  (st, ids)
    let {new_st, reply} = here(st, ids)
    next(reply, new_st, ids)

Sure.Core.to_lambolt.Builder.pure<A: Type>(a: A): Sure.Core.to_lambolt.Builder(A)
