Sure.Core.show(term: Sure.Term): String
  Sure.Core.show.go(term, 0, [])

Sure.Core.show.go(term: Sure.Term, indx: Nat, vars: List<Sure.Name>): String
  case term {
    ref:
      Sure.Name.show(term.name)
    var:
      Sure.Core.var_name(Nat.pred(Nat.sub(indx,term.indx)), term.name, 0, vars)
    typ:
      "*"
    all:
      let eras = term.eras
      let init = if eras then "%" else "@"
      let self = Sure.Name.show(term.self)
      let name = Sure.Name.show(term.name)
      let xtyp = Sure.Core.show.go(term.xtyp, indx, vars)
      let body = Sure.Core.show.go(
        term.body(
          Sure.Term.var(term.self,indx),
          Sure.Term.var(term.name,Nat.succ(indx))),
        Nat.succ(Nat.succ(indx)),
        List.cons!(term.name, List.cons!(term.self, vars)))
      String.flatten([init,self,"(",name,":",xtyp,") ",body])
    lam:
      let name = Sure.Name.show(term.name)
      let body = Sure.Core.show.go(
        term.body(Sure.Term.var(term.name,indx)),
        Nat.succ(indx),
        List.cons!(term.name, vars))
      String.flatten(["#",name," ",body])
    app:
      let func = Sure.Core.show.go(term.func, indx, vars)
      let argm = Sure.Core.show.go(term.argm, indx, vars)
      String.flatten(["(",func," ",argm,")"])
    let: 
      let name = Sure.Name.show(term.name)
      let expr = Sure.Core.show.go(term.expr, indx, vars)
      let body = Sure.Core.show.go(
        term.body(Sure.Term.var(term.name,indx)),
        Nat.succ(indx),
        List.cons!(term.name, vars))
      String.flatten(["!", name, " = ", expr, "; ", body])
    def:
      let name = Sure.Name.show(term.name)
      let expr = Sure.Core.show.go(term.expr, indx, vars)
      let body = Sure.Core.show.go(
        term.body(Sure.Term.var(term.name,indx)),
        Nat.succ(indx),
        List.cons!(term.name, vars))
      String.flatten(["$", name, " = ", expr, "; ", body])
    ann:
      let term = Sure.Core.show.go(term.term, indx, vars)
      let type = Sure.Core.show.go(term.type, indx, vars)
      String.flatten(["{",term,":",type,"}"])
    nat:
      String.flatten(["+", Nat.show(term.natx)])
    chr:
      String.flatten(["'", Sure.Code.escape.char(term.chrx), "'"])
    str:
      String.flatten(["\"", Sure.Code.escape(term.strx), "\""])
    imp:
      Sure.Core.show.go(term.expr, indx, vars)
    ori:
      Sure.Core.show.go(term.expr, indx, vars)
  } default "*"
