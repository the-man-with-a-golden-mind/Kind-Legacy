// Replaces "$0", "$1" and so on by the strings on the "vars" list
// - Sure.Comp.subst(["Mary","Sunday"], "Hello $0, today is $1!") == "Hello mary, today is Sunday!"
Sure.Comp.replace(str: String, vars: List(String)): String
  //log(str)
  case str {
    nil: str
    cons: 
      let a = str.head
      if U16.eql(a, '$') then 
        def is_num = (b) U16.gte(b, '0') && U16.lte(b, '9')
        let n_str = String.take_while(is_num, str.tail)
        if Nat.gtn(String.length(n_str), 0) then
          let n_str.tail = String.drop_while(is_num, str.tail)
          (vars[Nat.read(n_str)] <> "?") | Sure.Comp.replace(n_str.tail, vars)
        else
          String.cons(a, Sure.Comp.replace(str.tail, vars))
      else
        String.cons(a, Sure.Comp.replace(str.tail, vars))
  }
