Sure.Comp.dependency_sort.go(
  term: Sure.Comp
  defs: Sure.Comp.Defs
  seen: Sure.Map(Unit)
  list: List(Pair(String,Sure.Comp))
): Pair(BitsSet, List(Pair(String, Sure.Comp)))
  case term {
    ref: case Sure.Map.get!(term.name, seen) as got_seen {
      some: {seen,list}
      none: case Sure.Map.get!(term.name, defs) as got_term {
        none: {seen,list}
        some: 
          let term = got_term.value
          let seen = Sure.Map.set!(term.name, unit, seen)
          let {seen,list} = Sure.Comp.dependency_sort.go(term, defs, seen, list)
          let list = List.cons!({term.name, got_term.value}, list)
          {seen, list}
      }
    }
    lam:
      let {seen,list} = Sure.Comp.dependency_sort.go(term.body, defs, seen, list)
      {seen,list}
    app:
      let {seen,list} = Sure.Comp.dependency_sort.go(term.func, defs, seen, list)
      let {seen,list} = Sure.Comp.dependency_sort.go(term.argm, defs, seen, list)
      {seen,list}
    let:
      let {seen,list} = Sure.Comp.dependency_sort.go(term.expr, defs, seen, list)
      let {seen,list} = Sure.Comp.dependency_sort.go(term.body, defs, seen, list)
      {seen,list}
    eli:
      let {seen,list} = Sure.Comp.dependency_sort.go(term.expr, defs, seen, list)
      {seen,list}
    ins:
      let {seen,list} = Sure.Comp.dependency_sort.go(term.expr, defs, seen, list)
      {seen,list}
  } default {seen,list}
