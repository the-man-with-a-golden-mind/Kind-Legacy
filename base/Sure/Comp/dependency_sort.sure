Sure.Comp.dependency_sort.module(exports: List<String>, defs: Sure.Comp.Defs): List(Pair(String,Sure.Comp))
  let ret = {Sure.Map.new!, []} :: Pair<Sure.Map<Unit>, List<Pair<String, Sure.Comp>>>
  for export in exports with ret:
    let term = Sure.Comp.ref(export)
    let {seen, list} = ret
    Sure.Comp.dependency_sort.go(term, defs, seen, list)
  let {seen, list} = ret
  List.reverse!(list)

Sure.Comp.dependency_sort(main: String, defs: Sure.Comp.Defs): List(Pair(String,Sure.Comp))
  let term = Sure.Comp.ref(main)
  let seen = Sure.Map.new!
  let list = []
  let {seen,list} = Sure.Comp.dependency_sort.go(term, defs, seen, list)
  List.reverse!(list)

