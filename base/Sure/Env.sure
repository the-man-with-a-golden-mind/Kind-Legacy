// Process environment. Empty names are not names. Empty values are values.

type Sure.Env.Err {
  empty_name
  missing
  junk
}

Sure.Env.Err.show(e: Sure.Env.Err): String
  case e {
    empty_name: "empty_name"
    missing: "missing"
    junk: "junk"
  }

Sure.Env.Err.read(s: String): Sure.Env.Err
  if String.eql(s, "empty_name") then Sure.Env.Err.empty_name
  else if String.eql(s, "missing") then Sure.Env.Err.missing
  else if String.eql(s, "junk") then Sure.Env.Err.junk
  else if String.is_empty(s) then Sure.Env.Err.missing
  else Sure.Env.Err.junk

Sure.Env.ok_name(s: String): Bool
  if String.is_empty(s) then false
  else if String.includes(s, "\n") then false
  else if String.includes(s, "=") then false
  else true

Sure.Env.decode(raw: String): Outcome<Sure.Env.Err, String>
  Host.to_env(Host.decode(raw))

Sure.Env.decode_unit(raw: String): Outcome<Sure.Env.Err, Unit>
  Host.to_env_unit(Host.decode(raw))

Sure.Env.keys_of(s: String): List<String>
  if String.is_empty(s) then []
  else List.filter<String>(Sure.Env.ok_name, String.split(s, "\n"))

Sure.Env.decode_keys(raw: String): Outcome<Sure.Env.Err, List<String>>
  case Host.to_env(Host.decode(raw)) as o {
    err: Outcome.err<Sure.Env.Err, List<String>>(o.error)
    ok: Outcome.ok<Sure.Env.Err, List<String>>(Sure.Env.keys_of(o.value))
  }

Sure.Env.parse_nat(s: String): Outcome<Sure.Env.Err, Nat>
  case Parse.nat(s) as n {
    none: Outcome.err<Sure.Env.Err, Nat>(Sure.Env.Err.junk)
    some: Outcome.ok<Sure.Env.Err, Nat>(n.value)
  }

Sure.Env.parse_bool(s: String): Outcome<Sure.Env.Err, Bool>
  case Parse.bool(s) as b {
    none: Outcome.err<Sure.Env.Err, Bool>(Sure.Env.Err.junk)
    some: Outcome.ok<Sure.Env.Err, Bool>(b.value)
  }

Sure.Env.is_flag(s: String): Bool
  if String.is_empty(s) then false
  else if String.eql(s, "0") then false
  else if String.eql(s, "false") then false
  else if String.eql(s, "off") then false
  else if String.eql(s, "no") then false
  else true

Sure.Env.show_get(o: Outcome<Sure.Env.Err, String>): String
  case o {
    err: Sure.Env.Err.show(o.error)
    ok: o.value
  }

Sure.Env.get(name: String): IO<Outcome<Sure.Env.Err, String>>
  if Bool.not(Sure.Env.ok_name(name)) then
    IO.end<Outcome<Sure.Env.Err, String>>(Outcome.err<Sure.Env.Err, String>(Sure.Env.Err.empty_name))
  else IO {
    get e = Host.perform(Host.Op.env_get(name))
    return Host.to_env(e)
  }

Sure.Env.set(name: String, val: String): IO<Outcome<Sure.Env.Err, Unit>>
  if Bool.not(Sure.Env.ok_name(name)) then
    IO.end<Outcome<Sure.Env.Err, Unit>>(Outcome.err<Sure.Env.Err, Unit>(Sure.Env.Err.empty_name))
  else IO {
    get e = Host.perform(Host.Op.env_set(name, val))
    return Host.to_env_unit(e)
  }

Sure.Env.del(name: String): IO<Outcome<Sure.Env.Err, Unit>>
  if Bool.not(Sure.Env.ok_name(name)) then
    IO.end<Outcome<Sure.Env.Err, Unit>>(Outcome.err<Sure.Env.Err, Unit>(Sure.Env.Err.empty_name))
  else IO {
    get e = Host.perform(Host.Op.env_del(name))
    return Host.to_env_unit(e)
  }

Sure.Env.keys: IO<Outcome<Sure.Env.Err, List<String>>>
  IO {
    get e = Host.perform(Host.Op.env_keys)
    return case Host.to_env(e) as o {
      err: Outcome.err<Sure.Env.Err, List<String>>(o.error)
      ok: Outcome.ok<Sure.Env.Err, List<String>>(Sure.Env.keys_of(o.value))
    }
  }

Sure.Env.has(name: String): IO<Bool>
  IO {
    get r = Sure.Env.get(name)
    return Outcome.is_ok<Sure.Env.Err, String>(r)
  }

Sure.Env.get_or(name: String, def: String): IO<String>
  IO {
    get r = Sure.Env.get(name)
    return case r {
      err: def
      ok: r.value
    }
  }

Sure.Env.nat(name: String): IO<Outcome<Sure.Env.Err, Nat>>
  IO {
    get r = Sure.Env.get(name)
    return case r {
      err: Outcome.err<Sure.Env.Err, Nat>(r.error)
      ok: Sure.Env.parse_nat(r.value)
    }
  }

Sure.Env.bool(name: String): IO<Outcome<Sure.Env.Err, Bool>>
  IO {
    get r = Sure.Env.get(name)
    return case r {
      err: Outcome.err<Sure.Env.Err, Bool>(r.error)
      ok: Sure.Env.parse_bool(r.value)
    }
  }

Sure.Env.flag(name: String): IO<Bool>
  IO {
    get r = Sure.Env.get(name)
    return case r {
      err: false
      ok: Sure.Env.is_flag(r.value)
    }
  }
