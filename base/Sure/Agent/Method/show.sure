Sure.Agent.Method.show(m: Sure.Agent.Method): String
  case m {
    parse: "sure.parse"
    check: "sure.check"
    normalize: "sure.normalize"
    infer: "sure.infer"
    goal: "sure.goal"
    holes: "sure.holes"
    symbols: "sure.symbols"
    definition: "sure.definition"
    references: "sure.references"
    dependencies: "sure.dependencies"
    patch: "sure.patch"
    compile: "sure.compile"
    diagnostics: "sure.diagnostics"
    repair: "sure.repair"
    prove: "sure.prove"
    impact: "sure.impact"
    theorems: "sure.theorems"
    docs: "sure.docs"
    graph: "sure.graph"
    qc: "sure.qc"
    fill: "sure.fill"
    trace: "sure.trace"
    gen: "sure.gen"
    debug: "sure.debug"
  }
