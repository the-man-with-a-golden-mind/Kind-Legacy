Sure.Synth.load.cached.name(name: Sure.Name): String
  ".cache/" | Bits.hex.encode(Sure.Name.to_bits(name))

Sure.Synth.load.cached.get_file(name: Sure.Name): IO<String>
  IO.get_file(Sure.Synth.load.cached.name(name))

Sure.Synth.load.cached.set_file(name: Sure.Name, value: String): IO<Unit>
  IO.set_file(Sure.Synth.load.cached.name(name), value)

Sure.Synth.load.cached.def(name: Sure.Name): IO<Maybe<Sure.Def>>
  IO {
    get raw = Sure.Synth.load.cached.get_file(name)
    case Sure.Synth.load.cached.decode(raw) as rec {
      none: IO { return none }
      some: open rec.value; IO {
        get blob = Sure.Synth.load.cached.blob_key
        if Bool.not(String.eql(rec.value.blob, blob)) then IO { return none }
        else if String.is_empty(rec.value.file) then IO { return none }
        else IO {
          get file_hash = IO.file_hash(rec.value.file)
          if Bool.not(String.eql(rec.value.hash, file_hash)) then IO { return none }
          else IO {
            return some(Sure.Def.new(
              rec.value.file,
              "<cached>",
              {0,0},
              name,
              rec.value.term,
              rec.value.type,
              rec.value.isct,
              rec.value.arit,
              Sure.Status.done(true)
            ))
          }
        }
      }
    }
  }

Sure.Synth.load.cached.is_loop(name: String, defs: Sure.Defs): Bool
  case Sure.Map.get!(name, defs) as got {
    some: 
      open got.value
      case got.value.stat {
        done: got.value.stat.cached
      } default false
    none: false
  }

Sure.Synth.load.cached(names: List(Sure.Name), defs: Sure.Defs): IO<Maybe<Sure.Defs>>
  //log("- kslc " | String.join(", ", names)) 
  case names {
    nil: IO {
      return some(defs)
    }
    cons: if Sure.Synth.load.cached.is_loop(names.head, defs)
      then IO {
        //IO.print("-- " | names.head | " already cached")
        Sure.Synth.load.cached(names.tail, defs)
      }
      else IO {
        let name = names.head
        get defn = Sure.Synth.load.cached.def(name)
        case defn {
          none: IO {
            //IO.print("-- " | names.head | " cache failed")
            return none
          }
          some: open defn.value; IO {
            let defs = Sure.Map.set!(name, defn.value, defs)
            let deps = Sure.Map.new!
            let deps = Sure.Core.dependencies.go(defn.value.term, deps)
            let deps = Sure.Core.dependencies.go(defn.value.type, deps)
            let deps = Sure.Map.keys!(deps)
            get defs = Sure.Synth.load.cached(deps, defs)
            case defs {
              none: IO {
                //IO.print("-- " | names.head | " cache failed because of a dep")
                return none
              }
              some: IO {
                //IO.print("-- " | names.head | " cached!")
                Sure.Synth.load.cached(names.tail, defs.value)
              }
            }
          }
        }
      }
  }

Sure.Synth.load(name: Sure.Name, defs: Sure.Defs): IO<Maybe<Sure.Defs>>
  IO {
    // Cache is keyed by name. A project file on SURE_PATH/KIND_PATH must
    // not lose to a cached stdlib term of the same name (e.g. Main).
    get paths = Sure.Synth.path_env
    get shadowed = Sure.Synth.get_kind_code.search_files(
      Sure.Synth.files_of(name),
      String.split(paths, ":"))
    if Bool.not(String.is_empty(shadowed)) then IO {
      Sure.Synth.load.go(name, Sure.Synth.files_of(name), defs)
    } else IO {
      get cached_defs = Sure.Synth.load.cached([name], defs)
      case cached_defs {
        some: IO {
          return some(cached_defs.value)
        }
        none: IO {
          Sure.Synth.load.go(name, Sure.Synth.files_of(name), defs)
        }
      }
    }
  }

Sure.Synth.get_kind_code(file: String): IO(String)
  IO {
    get paths = Sure.Synth.path_env
    get from_path = Sure.Synth.get_kind_code.search(file, String.split(paths, ":"))
    if Bool.not(String.is_empty(from_path)) then IO {
      return from_path
    } else IO {
      get code = IO.get_file(file)
      if Bool.not(String.is_empty(code)) then IO {
        return code
      } else if String.is_upper(String.take(1, file)) then IO {
        get remote = IO.request("https://raw.githubusercontent.com/HigherOrderCO/Kind1/master/base/" | file)
        return remote
      } else IO {
        return ""
      }
    }
  }

Sure.Synth.get_kind_code.search(file: String, paths: List<String>): IO<String>
  case paths {
    nil:
      IO { return "" }
    cons:
      if String.is_empty(paths.head) then
        Sure.Synth.get_kind_code.search(file, paths.tail)
      else IO {
        get code = IO.get_file(paths.head | "/" | file)
        if String.is_empty(code) then
          Sure.Synth.get_kind_code.search(file, paths.tail)
        else IO {
          return code
        }
      }
  }

Sure.Synth.get_kind_code.search_files(files: List<String>, paths: List<String>): IO<String>
  case files {
    nil:
      IO { return "" }
    cons: IO {
      get code = Sure.Synth.get_kind_code.search(files.head, paths)
      if String.is_empty(code) then
        Sure.Synth.get_kind_code.search_files(files.tail, paths)
      else IO {
        return code
      }
    }
  }

Sure.Synth.load.go(name: String, files: List<String>, defs: Sure.Defs): IO<Maybe<Sure.Defs>>
  case files {
    nil: IO {
      return none
    }
    cons: IO {
      get code = Sure.Synth.get_kind_code(files.head)
      let read = Sure.Defs.read(files.head, code, defs)
      case read {
        left: Sure.Synth.load.go(name, files.tail, defs)
        right: IO {
          let defs = read.value
          case Sure.Map.get!(name, defs) as got {
            none: Sure.Synth.load.go(name, files.tail, defs),
            some: IO {
              return some(defs)
            }
          }
        }
      }
    }
  }
