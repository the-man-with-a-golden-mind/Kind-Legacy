// synthesizes all definitions needed for a term
Sure.Synth.one(name: Sure.Name, defs: Sure.Defs): IO<Maybe<Sure.Defs>>
  case Sure.Map.get!(name, defs) as got {
    // load needed definitions from files
    none: IO {
      get time_a = IO.get_time
      //IO.print("- load " | name)
      get loaded = Sure.Synth.load(name, defs);
      case loaded {
        none: IO {
          return none
        }
        some: IO {
          get time_b = IO.get_time
          //IO.print("- gots " | name | " " | Nat.show(time_b - time_a))
          get result = Sure.Synth.one(name, loaded.value)
          get time_c = IO.get_time
          //IO.print("- done " | name | " " | Nat.show(time_c - time_a))
          return result
        }
      }
    }
    some: 
      open got.value
      IO {
        let file = got.value.file;
        let code = got.value.code;
        let orig = got.value.orig;
        let name = got.value.name;
        let term = got.value.term;
        let type = got.value.type;
        let isct = got.value.isct;
        let arit = got.value.arit;
        let stat = got.value.stat;
        //let skip = Debug.log!(String.flatten([name, ": ", Sure.Term.show(type), " = ", Sure.Term.show(term)]), (x) Unit.new);
        //log(String.flatten(["synth ", name, " ", case stat { init: "INIT", wait: "WAIT", done: "DONE", fail: "FAIL" }])) // DEBUG
        // check state of definition
        case stat {
          wait: IO { return some(defs); },
          done: IO { return some(defs); },
          fail: IO { return some(defs); },
          init: IO {
            //IO.print("- CHEK " | name)
            let defs = Sure.Map.set!(name, Sure.Def.new(file, code, orig, name, term, type, isct, arit, Sure.Status.wait), defs);
            let checked = do Sure.Check {
              get chk_type = Sure.Term.check(type, Maybe.some!(Sure.Term.typ), defs, [], Sure.Path.Maybe.Builder.i(Sure.Path.Maybe.Builder.nil), Maybe.none!);
              get chk_term = Sure.Term.check(term, Maybe.some!(type), defs, [], Sure.Path.Maybe.Builder.o(Sure.Path.Maybe.Builder.nil), Maybe.none!);
              return Unit.new;
            };
            case checked {
              result:
                //let skip = Debug.log!(String.join("\n", List.mapped!(checked.errors)!((x) String.concat("-- ", Sure.Error.show(x,Sure.Map.new!)))), (x) Unit.new);
                if List.is_empty!(checked.errors) then IO {
                  if Sure.Term.has_holes(term) then IO {
                    let stat = Sure.Status.fail([
                      Sure.Error.show_goal("_", [], false, some(type), [])
                    ]);
                    let defs = Sure.Map.set!(name, Sure.Def.new(file, code, orig, name, term, type, isct, arit, stat), defs);
                    return some(defs);
                  } else IO {
                  let defs = Sure.Map.def(file, code, orig, name, term, type, isct, arit, true, defs);
                  //get time = IO.get_file_mtime(file)
                  //IO.set_file(".cache/" | name | ".term", Sure.Core.show(term))
                  //IO.set_file(".cache/" | name | ".type", Sure.Core.show(type))
                  //IO.set_file(".cache/" | name | ".isct", Bool.show(isct))
                  //IO.set_file(".cache/" | name | ".arit", Nat.show(arit))
                  //IO.set_file(".cache/" | name | ".time", time)
                  //IO.set_file(".cache/" | name | ".file", file)
                  return some(defs);
                  };
                } else IO {
                  get fixed = Sure.Synth.fix(file, code, orig, name, term, type, isct, arit, defs, checked.errors, Bool.false);
                  case fixed {
                    none: IO {
                      let stat = Sure.Status.fail(checked.errors);
                      let defs = Sure.Map.set!(name, Sure.Def.new(file, code, orig, name, term, type, isct, arit, stat), defs);
                      return some(defs);
                    },
                    some: Sure.Synth.one(name, fixed.value),
                  };
                }
            };
          }
        };
      }
  }
