// Timing helpers for `sure bench`. Empty samples are not a mean of 0 by
// accident: `best` is `none`, `mean` is the explicit empty sentinel 0.

Sure.Bench.delta(t0: Nat, t1: Nat): Nat
  if Nat.ltn(t1, t0) then 0 else Nat.sub(t1, t0)

Sure.Bench.sum(xs: List<Nat>): Nat
  case xs {
    nil: 0
    cons: Nat.add(xs.head, Sure.Bench.sum(xs.tail))
  }

Sure.Bench.mean(xs: List<Nat>): Nat
  let n = List.length<Nat>(xs)
  case n {
    zero: 0
    succ: Nat.div(Sure.Bench.sum(xs), n)
  }

Sure.Bench.best.go(xs: List<Nat>, acc: Nat): Nat
  case xs {
    nil: acc
    cons:
      if Nat.ltn(xs.head, acc) then
        Sure.Bench.best.go(xs.tail, xs.head)
      else
        Sure.Bench.best.go(xs.tail, acc)
  }

Sure.Bench.best(xs: List<Nat>): Maybe<Nat>
  case xs {
    nil: none
    cons: some(Sure.Bench.best.go(xs.tail, xs.head))
  }
