#!chezscheme
;; Chez IO kernel used by host_smoke (and importable without the 1.5MB compiler).
(library (kind-host)
  (export run_io)
  (import (chezscheme))

(define-record string-view
  ((immutable data)
   (immutable start)
   (immutable end)))

(define (kstring->string x)
  (if (string-view? x)
    (substring (string-view-data x) (string-view-start x) (string-view-end x))
    x))

(define (as-str x)
  (if (string? x) x (kstring->string x)))

(define (kstring-append x y)
  (string-append (kstring->string x) (kstring->string y)))

(define (kstring_join sep strs fst)
  (if (null? strs)
    ""
    (kstring-append
      (if fst "" sep)
      (kstring-append
        (car strs)
        (kstring_join sep (cdr strs) #f)))))

(define (first_index_of chr kstr idx)
  (let ((str (kstring->string kstr)))
    (if (= idx (string-length str))
      -1
      (if (char=? (string-ref str idx) chr)
        idx
        (first_index_of chr str (+ idx 1))))))

(define (last_index_of chr kstr idx)
  (let ((str (kstring->string kstr)))
    (if (= idx (string-length str))
      -1
      (let ((rest (last_index_of chr str (+ idx 1))))
        (if (char=? (string-ref str idx) chr)
          (max idx rest)
          rest)))))

(define (split_at_first chr kstr)
  (let ((str (kstring->string kstr)))
    (let ((split_idx (first_index_of chr str 0)))
      (if (= split_idx -1)
        str
        (cons
          (substring str 0 split_idx)
          (substring str (+ split_idx 1) (string-length str)))))))

(define (split_at_last chr kstr)
  (let ((str (kstring->string kstr)))
    (let ((split_idx (last_index_of chr str 0)))
      (if (= split_idx -1)
        str
        (cons
          (substring str 0 split_idx)
          (substring str (+ split_idx 1) (string-length str)))))))

(define (time_to_string time)
  (number->string
    (+ (* (time-second time) 1000)
      (div (time-nanosecond time) 1000000))))

(define (print txt)
  (display (kstring->string txt))
  (newline))

(define HOST_STATE (make-hashtable string-hash string=?))
(define HOST_TCP (make-hashtable string-hash string=?))
(define HOST_TCP_N 0)
(define HEX-DIGITS "0123456789abcdef")

(define (trim-left s)
  (let ((n (string-length s)))
    (let loop ((i 0))
      (if (and (< i n) (char=? (string-ref s i) #\space))
        (loop (+ i 1))
        (substring s i n)))))

(define (first-line s)
  (let ((i (first_index_of #\newline s 0)))
    (if (= i -1) s (substring s 0 i))))

(define (tmp-path)
  (string-append "/tmp/sure-scm-"
    (number->string (time-nanosecond (current-time)))
    "-"
    (number->string (mod (time-second (current-time)) 1000000))))

(define (write-text path text)
  (when (file-exists? path) (delete-file path))
  (call-with-output-file path (lambda (p) (display (as-str text) p))))

(define (read-text path)
  (if (file-exists? path)
    (call-with-input-file path get-string-all)
    ""))

(define (delete-if path)
  (when (file-exists? path) (delete-file path)))

(define (bytes->hex bv)
  (if (not (bytevector? bv))
    ""
    (let* ((n (bytevector-length bv))
           (s (make-string (* n 2))))
      (do ((i 0 (+ i 1)))
          ((= i n) s)
        (let ((b (bytevector-u8-ref bv i)))
          (string-set! s (* i 2) (string-ref HEX-DIGITS (div b 16)))
          (string-set! s (+ (* i 2) 1) (string-ref HEX-DIGITS (mod b 16))))))))

(define (hex-nibble c)
  (cond
    ((char<=? #\0 c #\9) (- (char->integer c) (char->integer #\0)))
    ((char<=? #\a c #\f) (+ 10 (- (char->integer c) (char->integer #\a))))
    ((char<=? #\A c #\F) (+ 10 (- (char->integer c) (char->integer #\A))))
    (else #f)))

(define (hex->bytes s)
  (let* ((s (as-str s)) (n (string-length s)))
    (if (odd? n)
      #f
      (let ((bv (make-bytevector (div n 2))))
        (let loop ((i 0))
          (if (= i n)
            bv
            (let ((hi (hex-nibble (string-ref s i)))
                  (lo (hex-nibble (string-ref s (+ i 1)))))
              (if (or (not hi) (not lo))
                #f
                (begin
                  (bytevector-u8-set! bv (div i 2) (+ (* hi 16) lo))
                  (loop (+ i 2)))))))))))

(define (read-bytes path)
  (if (not (file-exists? path))
    #f
    (let ((p (open-file-input-port path)))
      (let ((bv (get-bytevector-all p)))
        (close-port p)
        (if (eof-object? bv) (make-bytevector 0) bv)))))

(define (write-bytes path bv)
  (let ((sp (split_at_last #\/ path)))
    (when (pair? sp)
      (unless (string=? (car sp) "")
        (system (string-append "mkdir -p " (car sp))))))
  (when (file-exists? path) (delete-file path))
  (let ((p (open-file-output-port path)))
    (put-bytevector p bv)
    (close-port p)))

(define (openssl-hex-line line)
  (let ((i (first_index_of #\= (as-str line) 0)))
    (if (= i -1)
      ""
      (first-line (trim-left (substring (as-str line) (+ i 1) (string-length (as-str line))))))))

(define (system-ok? st)
  (or (eq? st #t) (and (number? st) (zero? st))))

(define (run-shell cmd)
  (let ((outf (tmp-path)))
    (let ((st (system (string-append cmd " > " outf " 2>/dev/null"))))
      (let ((out (read-text outf)))
        (delete-if outf)
        (cons st out)))))

(define (sha256-hex text)
  (let ((inf (tmp-path)))
    (write-text inf (as-str text))
    (let ((r (run-shell (string-append "openssl dgst -sha256 -hex " inf))))
      (delete-if inf)
      (if (system-ok? (car r))
        (openssl-hex-line (cdr r))
        #f))))

(define (hmac-sha256-hex key msg)
  (let ((inf (tmp-path))
        (keyhex (bytes->hex (string->utf8 (as-str key)))))
    (write-text inf (as-str msg))
    (let ((r (run-shell
               (if (string=? keyhex "")
                 (string-append "openssl dgst -sha256 -hmac '' -hex " inf)
                 (string-append "openssl dgst -sha256 -mac HMAC -macopt hexkey:" keyhex " -hex " inf)))))
      (delete-if inf)
      (if (system-ok? (car r))
        (openssl-hex-line (cdr r))
        #f))))

(define (gzip-hex text)
  (let ((inf (tmp-path)) (outf (tmp-path)))
    (write-text inf (as-str text))
    (let ((st (system (string-append "gzip -c " inf " > " outf " 2>/dev/null"))))
      (let ((bv (read-bytes outf)))
        (delete-if inf)
        (delete-if outf)
        (if (and (system-ok? st) bv)
          (bytes->hex bv)
          #f)))))

(define (gunzip-hex hex)
  (let ((bv (hex->bytes hex)))
    (if (not bv)
      #f
      (let ((inf (tmp-path)) (outf (tmp-path)))
        (write-bytes inf bv)
        (let ((st (system (string-append "gzip -dc " inf " > " outf " 2>/dev/null"))))
          (let ((txt (read-text outf)))
            (delete-if inf)
            (delete-if outf)
            (if (system-ok? st) txt #f)))))))

(define (unsafe-host-char? c)
  (not (or (char-alphabetic? c)
           (char-numeric? c)
           (memv c '(#\. #\- #\: #\[ #\])))))

(define (tcp-connect-nc host port)
  (guard (ex [#t "1\nconnect"])
    (let-values ([(to from err pid)
                  (open-process-ports
                    (string-append "nc -G 1 " host " " (number->string port))
                    (buffer-mode block)
                    (native-transcoder))])
      (set! HOST_TCP_N (+ HOST_TCP_N 1))
      (let ((id (number->string HOST_TCP_N)))
        (hashtable-set! HOST_TCP id (vector to from err pid))
        (string-append "0\n" id)))))

(define (tcp-connect-raw host port tls)
  (cond
    ((or (string=? host "") (exists unsafe-host-char? (string->list host)))
      "1\nbad host")
    ((not (and (number? port) (integer? port) (>= port 1) (<= port 65535)))
      "1\nbad port")
    ((not (string=? tls "0"))
      "1\nnot implemented")
    (else
      (tcp-connect-nc host port))))

(define (proc-exec cmd)
  (let ((outf (tmp-path)))
    (let ((st (system (string-append (as-str cmd) " > " outf " 2>&1"))))
      (let ((out (read-text outf)))
        (delete-if outf)
        (let ((code (cond
                      ((eq? st #t) 0)
                      ((number? st) (if (> st 255) (mod st 256) st))
                      (else 1))))
          (string-append "0\n" (number->string code) "\n" out))))))

(define (get_line)
  (get-line (current-input-port)))

(define (del_file file)
  (delete-file (kstring->string file)))

(define (get_file ifile)
  (let ((file (kstring->string ifile)))
    (if (file-exists? file)
      (let ((port (open-input-file file)))
        (let ((text (get-string-all port)))
          (close-input-port port)
          text))
      "")))

(define (set_file file text)
  (system (string-append "mkdir -p " (car (split_at_last #\/ file))))
  (when (file-exists? file) (delete-file file))
  (let ((port (open-output-file file)))
    (display text port)
    (close-output-port port)))

(define (get_dir path)
  (directory-list path))

(define (get_file_mtime file)
  (time_to_string (file-modification-time (kstring->string file))))

(define (get_time)
  (time_to_string (current-time)))

(define (io_action iname)
  (let ((name (kstring->string iname)))
  (case name
    ("print" (lambda (x) (print x)))
    ("put_string" (lambda (x) (display x)))
    ("get_line" (lambda (x) (get_line)))
    ("del_file" (lambda (x) (del_file x)))
    ("get_file" (lambda (x) (get_file x)))
    ("set_file" (lambda (x) (let ((file_text (split_at_first #\= (kstring->string x)))) (set_file (car file_text) (cdr file_text)))))
    ("get_dir" (lambda (x) (get_dir x)))
    ("get_file_mtime" (lambda (x) (get_file_mtime x)))
    ("get_time" (lambda (x) (get_time)))
    ("request" (lambda (x) ""))
    ("get_args" (lambda (x)
      (kstring_join " " (map (lambda (a) a) (cdr (command-line))) #t)))
    ("get_env" (lambda (x) (or (getenv (kstring->string x)) "")))
    ("get_state" (lambda (x)
      (or (hashtable-ref HOST_STATE (as-str x) #f) "")))
    ("set_state" (lambda (x)
      (let ((s (as-str x)))
        (let ((nl (first_index_of #\newline s 0)))
          (if (= nl -1)
            (hashtable-set! HOST_STATE s "")
            (hashtable-set! HOST_STATE (substring s 0 nl) (substring s (+ nl 1) (string-length s)))))
        "")))
    ("get_random" (lambda (x)
      (let ((r (run-shell "openssl rand -hex 4")))
        (if (system-ok? (car r))
          (let ((hex (first-line (cdr r))))
            (string-append "0." hex))
          "0.5"))))
    ("sha256" (lambda (x)
      (or (sha256-hex x) "")))
    ("sha256_ex" (lambda (x)
      (let ((h (sha256-hex x)))
        (if h (string-append "0\n" h) "1\nopenssl"))))
    ("hmac_sha256" (lambda (x)
      (let ((s (as-str x)))
        (let ((nl (first_index_of #\newline s 0)))
          (if (= nl -1)
            "1\nbad param"
            (let ((h (hmac-sha256-hex (substring s 0 nl) (substring s (+ nl 1) (string-length s)))))
              (if h (string-append "0\n" h) "1\nopenssl")))))))
    ("file_hash" (lambda (x)
      (let ((p (as-str x)))
        (if (not (file-exists? p))
          ""
          (let ((r (run-shell (string-append "openssl dgst -sha256 -hex " p))))
            (if (system-ok? (car r)) (openssl-hex-line (cdr r)) ""))))))
    ("cwd" (lambda (x) (current-directory)))
    ("fs_read_ex" (lambda (x) (string-append "0\n" (get_file x))))
    ("fs_write_ex" (lambda (x)
      (let ((s (kstring->string x)))
        (let ((nl (first_index_of #\newline s 0)))
          (if (= nl -1)
            (begin (set_file s "") "0\n")
            (begin (set_file (substring s 0 nl) (substring s (+ nl 1) (string-length s))) "0\n"))))))
    ("fs_del_ex" (lambda (x)
      (let ((f (kstring->string x)))
        (if (file-exists? f)
          (begin (delete-file f) "0\n")
          "1\nENOENT"))))
    ("set_file2" (lambda (x)
      (let ((s (kstring->string x)))
        (let ((nl (first_index_of #\newline s 0)))
          (if (= nl -1)
            (begin (set_file s "") "")
            (begin (set_file (substring s 0 nl) (substring s (+ nl 1) (string-length s))) ""))))))
    ("get_dir_ex" (lambda (x)
      (let ((p (kstring->string x)))
        (if (file-directory? p)
          (string-append "0\n" (kstring_join ";" (map kstring->string (directory-list p)) #t))
          "1\nENOENT"))))
    ("http" (lambda (x) "1\nnot implemented"))
    ("job_start" (lambda (x) "0"))
    ("job_await" (lambda (x) "0\n"))
    ("job_race" (lambda (x) "0"))
    ("job_cancel" (lambda (x) ""))
    ("tcp_connect" (lambda (x)
      (let ((s (as-str x)))
        (let ((p1 (split_at_first #\newline s)))
          (if (not (pair? p1))
            "1\nbad param"
            (let ((host (car p1)) (rest (cdr p1)))
              (let ((p2 (split_at_first #\newline rest)))
                (let ((port (if (pair? p2) (string->number (car p2)) (string->number rest)))
                      (tls (if (pair? p2) (cdr p2) "0")))
                  (tcp-connect-raw host port (if (string? tls) tls "0"))))))))))
    ("tcp_send" (lambda (x)
      (let ((s (as-str x)))
        (let ((nl (first_index_of #\newline s 0)))
          (let ((id (if (= nl -1) s (substring s 0 nl)))
                (data (if (= nl -1) "" (substring s (+ nl 1) (string-length s)))))
            (let ((rec (hashtable-ref HOST_TCP id #f)))
              (if (not rec)
                "1\nclosed"
                (let ((to (vector-ref rec 0)))
                  (display data to)
                  (flush-output-port to)
                  "0\n"))))))))
    ("tcp_recv" (lambda (x)
      (let ((rec (hashtable-ref HOST_TCP (as-str x) #f)))
        (if (not rec)
          "1\nclosed"
          (guard (ex [#t "0\n"])
            (let ((from (vector-ref rec 1)))
              (let ((s (get-string-some from)))
                (if (or (not s) (eof-object? s)) "0\n" (string-append "0\n" s)))))))))
    ("tcp_close" (lambda (x)
      (let ((id (as-str x)))
        (let ((rec (hashtable-ref HOST_TCP id #f)))
          (when rec
            (guard (ex [#t #f]) (close-port (vector-ref rec 0)))
            (guard (ex [#t #f]) (close-port (vector-ref rec 1)))
            (hashtable-delete! HOST_TCP id))
          ""))))
    ("udp_bind" (lambda (x) "1\nnot implemented"))
    ("udp_send" (lambda (x) "1\nnot implemented"))
    ("udp_recv" (lambda (x) "1\nnot implemented"))
    ("udp_close" (lambda (x) ""))
    ("ws_connect" (lambda (x) "1\nnot implemented"))
    ("http_listen" (lambda (x) "1\nnot implemented"))
    ("http_recv" (lambda (x) ""))
    ("http_reply" (lambda (x) ""))
    ("http_stop" (lambda (x) ""))
    ("proc_spawn" (lambda (x) "1\nnot implemented"))
    ("proc_kill" (lambda (x) "1\nnot implemented"))
    ("proc_wait" (lambda (x) "1\nnot implemented"))
    ("fs_read_hex" (lambda (x)
      (let ((p (as-str x)))
        (let ((bv (read-bytes p)))
          (if bv (string-append "0\n" (bytes->hex bv)) "1\nENOENT")))))
    ("fs_write_hex" (lambda (x)
      (let ((s (as-str x)))
        (let ((nl (first_index_of #\newline s 0)))
          (let ((fpath (if (= nl -1) s (substring s 0 nl)))
                (hex (if (= nl -1) "" (substring s (+ nl 1) (string-length s)))))
            (let ((bv (hex->bytes hex)))
              (if (not bv)
                "1\nbad hex"
                (begin (write-bytes fpath bv) "0\n"))))))))
    ("db_connect" (lambda (x) "1\nnot implemented"))
    ("db_get" (lambda (x) "1\nnot implemented"))
    ("db_set" (lambda (x) "1\nnot implemented"))
    ("db_query" (lambda (x) "1\nnot implemented"))
    ("db_close" (lambda (x) ""))
    ("gzip" (lambda (x)
      (let ((h (gzip-hex x)))
        (if h (string-append "0\n" h) "1\ngzip"))))
    ("gunzip" (lambda (x)
      (let ((t (gunzip-hex x)))
        (if t (string-append "0\n" t) "1\ngunzip"))))
    ("proc_exec" (lambda (x) (proc-exec x)))
    ("dns" (lambda (x) "1\nnot implemented"))
    ("exit" (lambda (x) (exit 0)))
    ("sleep" (lambda (x)
      (let ((ms (string->number (as-str x))))
        (if (and ms (>= ms 0))
          (let ((sec (div (exact (floor ms)) 1000))
                (nsec (* (mod (exact (floor ms)) 1000) 1000000)))
            (sleep (make-time 'time-duration nsec sec))
            "")
          ""))))
    (else (display (string-append "IO action not found: " name))))))

(define (run_io io)
  (case (vector-ref io 0)
    ('IO.end (vector-ref io 1))
    ('IO.ask (let (
      (io_query (vector-ref io 1))
      (io_param (vector-ref io 2))
      (io_then (vector-ref io 3)))
      (run_io (io_then ((io_action io_query) io_param)))))))
)
